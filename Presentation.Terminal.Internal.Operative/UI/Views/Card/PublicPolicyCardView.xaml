<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts.Models.PublicPolicy.DTOs;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Views.Card.PublicPolicyCardView"
    x:DataType="interop_dto_models:PublicPolicyBasicDtoModel">
    <Frame InputTransparent="{OnPlatform Default=False, Android=True}">
        <StackLayout Orientation="Vertical">
            <Label
                VerticalOptions="FillAndExpand"
                MaxLines="2"
                LineBreakMode="TailTruncation"
                Text="{Binding Title}" />
            <VerticalStackLayout>
                <Label 
                    Style="{StaticResource CaptionPropertyLabelStyle}"
                    Margin="0,8,0,0"
                    Text="Tipo" />
                <Label
                    Style="{StaticResource OffLabelStyle}"
                    Text="{Binding Kind}" />
            </VerticalStackLayout>
        </StackLayout>
    </Frame>
</ContentView>
