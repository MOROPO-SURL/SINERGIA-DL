<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.User.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Views.Card.UserCardView"
    x:DataType="interop_dto_models:UserBasicDtoModel">
    <Frame InputTransparent="{OnPlatform Default=False, Android=True}">
        <VerticalStackLayout 
            VerticalOptions="Center"
            Spacing="4">
            <Label
                FontAttributes="Bold"
                LineBreakMode="TailTruncation"
                Text="{Binding Id}" />
            <Label LineBreakMode="TailTruncation">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Name}" />
                        <Span Text="{Binding LastName, StringFormat=' {0}'}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
    </Frame>
</ContentView>
