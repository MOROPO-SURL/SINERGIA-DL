<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseDetailEntityPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_constants="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Internal.Operative.Constants"
    xmlns:local_detail_page_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Internal.Operative.Models.Page.StrategicLine.Detail"
    xmlns:local_ui_card_views="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Internal.Operative.UI.Views.Card"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.StrategicLine.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    xmlns:interop_trace_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.StrategicLineTrace.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    xmlns:common_ui_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.Models;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_converters="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Converters;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Internal.Operative.UI.Pages.StrategicLine.Detail.StrategicLineDetailPage"
    x:TypeArguments="interop_dto_models:StrategicLineDetailDtoModel,local_detail_page_models:StrategicLineDetailPageModel"
    x:DataType="local_detail_page_models:StrategicLineDetailPageModel"
    Shell.TabBarIsVisible="False"
    Title="Detalles de Línea estratégica">
    <ContentPage.Resources>
        <ResourceDictionary>
            <common_ui_converters:ImageBasicModelToImageSourceConverter x:Key="ImageBasicModelToImageSourceConverter" />

            <communitytoolkit_converters:IsNullConverter x:Key="IsNullConverter" />
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Modificar"
            Command="{Binding ModifyCommand, Mode=OneTime}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons"  
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xF90B;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Eliminar"
            Command="{Binding RemoveCommand, Mode=OneTime}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xFA79;"  />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <Grid 
                    Style="{StaticResource FormFluentChildGridStyle}"
                    ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Column="0"
                        FontSize="Medium"
                        VerticalOptions="Start"
                        Text="{Binding Model.Axe.Id, StringFormat='{0}.'}" />
                    <Label
                        Grid.Column="1"
                        VerticalOptions="Start"
                        FontSize="Medium"
                        Text="{Binding Model.Index, StringFormat='{0}.'}" />
                    <Label
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        FontSize="Medium"
                        Text="{Binding Model.Name}" />
                </Grid>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}"
                        Text="Eje estratégico" />
                    <Label
                        Style="{StaticResource ValuePropertyLabelStyle}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Model.Axe.Id, FallbackValue='---'}" />
                                <Span Text="{Binding Model.Axe.Name, StringFormat='. {0}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=3, ExtraLargeContainerColumn=4, LargeContainerColumn=6, MediumContainerColumn=8, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Coordinador" />
                        <Frame>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border 
                                    Grid.Column="0"
                                    StrokeThickness="4"
                                    StrokeLineJoin="Bevel">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="36" />
                                    </Border.StrokeShape>
                                    <Image
                                        WidthRequest="72" HeightRequest="72"
                                        Source="{Binding Model.Coordinator.Image, Converter={StaticResource ImageBasicModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                                </Border>
                                <VerticalStackLayout 
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        ToolTipProperties.Text="{Binding Model.Coordinator.Name}"
                                        Text="{Binding Model.Coordinator.Name}" />
                                    <Label
                                        MaxLines="1"
                                        LineBreakMode="TailTruncation"
                                        ToolTipProperties.Text="{Binding Model.Coordinator.LastName}"
                                        Text="{Binding Model.Coordinator.LastName}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}"
                        Text="Objetivo" />
                    <Label
                        Style="{StaticResource ValuePropertyLabelStyle}"
                        Text="{Binding Model.Objective}" />
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Objetivos específicos" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <CollectionView ItemsSource="{Binding Model.SpecificObjectives}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="interop_dto_models:StrategicLineSpecificObjectiveDetailDtoModel">
                                <Frame Padding="8">
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label
                                            Margin="8"
                                            HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                            LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontAttributes="Bold"
                                                        Text="{Binding Index, StringFormat='{0}.'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding Content}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Button
                                            Style="{StaticResource FontIconImageButtonStyle}"
                                            VerticalOptions="Center"
                                            Text="&#xF2FD;"
                                            Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DetailSpecificObjectiveCommand, Mode=OneTime}"
                                            CommandParameter="{Binding Mode=OneTime}" />
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Políticas públicas" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <CollectionView ItemsSource="{Binding Model.PublicPolicies}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout 
                                Orientation="Vertical" 
                                Span="2" 
                                HorizontalItemSpacing="{Static local_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" 
                                VerticalItemSpacing="{Static local_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <common_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior 
                                ItemSpacing="{Static local_constants:ListEntityPageConstants.ADAPTABLE_GRIDITESMLAYOUT_COLLECTIONVIEW_BEHAVIOR_ITEMSSPACING}" 
                                ItemWidth="{Static local_constants:CardViewSizeConstants.PUBLICPOLICY_DEFAULT_CARD_VIEW_WIDTH}" />
                        </CollectionView.Behaviors>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <local_ui_card_views:PublicPolicyCardView HeightRequest="{Static local_constants:CardViewSizeConstants.PUBLICPOLICY_DEFAULT_CARD_VIEW_HEIGHT}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Grupo de trabajo" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <CollectionView ItemsSource="{Binding Model.Organizations}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout 
                                Orientation="Vertical" 
                                Span="2" 
                                HorizontalItemSpacing="{Static local_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" 
                                VerticalItemSpacing="{Static local_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <common_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior 
                                ItemSpacing="{Static local_constants:ListEntityPageConstants.ADAPTABLE_GRIDITESMLAYOUT_COLLECTIONVIEW_BEHAVIOR_ITEMSSPACING}" 
                                ItemWidth="{Static local_constants:CardViewSizeConstants.ORGANIZATION_DEFAULT_CARD_VIEW_WIDTH}" />
                        </CollectionView.Behaviors>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <local_ui_card_views:OrganizationCardView HeightRequest="{Static local_constants:CardViewSizeConstants.ORGANIZATION_DEFAULT_CARD_VIEW_HEIGHT}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}"
                        Text="Descripción" />
                    <Label
                        Style="{StaticResource ValuePropertyLabelStyle}"
                        Text="{Binding Model.Description, TargetNullValue='---'}" />
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Historial de cambios" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <Button
                        IsVisible="{Binding Traces, Converter={StaticResource IsNullConverter}}"
                        HorizontalOptions="Center"
                        Text="Mostrar"
                        Command="{Binding FetchTraceCommand, Mode=OneTime}" />
                    <CollectionView 
                        IsVisible="{Binding Traces, Converter={StaticResource IsNotNullConverter}}"
                        ItemsSource="{Binding Traces}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="interop_trace_dto_models:StrategicLineTraceDetailDtoModel">
                                <Grid ColumnSpacing="{Static local_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Column="0" Grid.RowSpan="3"
                                        VerticalOptions="Center"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="48"
                                        Text="&#xF0226;"
                                        TextColor="DimGray" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        FontAttributes="Bold"
                                        Text="{Binding Kind}" />
                                    <Label
                                        Grid.Column="1" Grid.Row="1"
                                        Text="{Binding Author}" />
                                    <Label
                                        Grid.Column="1" Grid.Row="2"
                                        FontAttributes="Italic"
                                        Text="{Binding CreatedAt}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button
                        IsVisible="{Binding Traces, Converter={StaticResource IsNotNullConverter}}"
                        HorizontalOptions="Center"
                        Text="Actualizar"
                        Command="{Binding FetchTraceCommand, Mode=OneTime}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</common_ui_base_pages:BaseDetailEntityPage>