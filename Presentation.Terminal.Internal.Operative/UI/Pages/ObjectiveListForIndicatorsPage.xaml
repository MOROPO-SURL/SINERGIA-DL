<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseListEntityPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Constants"
    xmlns:local_list_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Models.Page.Objective"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.Objective.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    xmlns:common_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Constants;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Pages.ObjectiveListForIndicatorsPage"
    x:TypeArguments="interop_dto_models:ObjectiveBasicDtoModel,local_list_page_models:ObjectiveListForIndicatorsPageModel"
    x:DataType="local_list_page_models:ObjectiveListForIndicatorsPageModel"
    Title="Estado de indicadores: Objetivos"
    IsEnabled="{Binding IsEnabled}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Command="{Binding ReloadCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xF450;"  />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <StackLayout Orientation="Vertical">
                <Frame 
                    Style="{StaticResource InfoToastFrameStyle}"
                    Margin="16,16,16,0">
                    <StackLayout 
                        Orientation="Horizontal"
                        Spacing="8">
                        <Label
                            VerticalOptions="Center"
                            FontSize="32"
                            FontFamily="MaterialDesignIcons"
                            TextColor="White"
                            Text="&#xF2FD;" />
                        <Label 
                            HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                            TextColor="White"
                            Text="Seleccione el Objetivo deseado para trabajar con sus indicadores" />
                    </StackLayout>
                </Frame>
                <SearchBar 
                    Style="{StaticResource ListEntityPageSearchBarStyle}"
                    Placeholder="-- buscar por nombre --"
                    Text="{Binding SearchParameter}"
                    SearchCommand="{Binding SearchCommand, Mode=OneTime}" />
                <Grid VerticalOptions="FillAndExpand">
                    <CollectionView
                        x:Name="ItemsCollectionView"
                        Style="{StaticResource ListEntityPageCollectionViewStyle}"
                        ItemsSource="{Binding Items}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout 
                                Orientation="Vertical" 
                                Span="2" 
                                HorizontalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" 
                                VerticalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <common_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior 
                                ItemSpacing="{Static common_constants:ListEntityPageConstants.ADAPTABLE_GRIDITESMLAYOUT_COLLECTIONVIEW_BEHAVIOR_ITEMSSPACING}" 
                                ItemWidth="{Static local_constants:CardViewSizeConstants.OBJECTIVE_DEFAULT_CARD_VIEW_WIDTH}" />
                        </CollectionView.Behaviors>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="interop_dto_models:ObjectiveBasicDtoModel">
                                <Frame HeightRequest="{Static local_constants:CardViewSizeConstants.OBJECTIVE_DEFAULT_CARD_VIEW_HEIGHT}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DetailItemCommand, Mode=OneTime}" CommandParameter="{Binding Mode=OneTime}" />
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <StackLayout
                                            Spacing="4"
                                            Orientation="Horizontal">
                                            <Label
                                                VerticalOptions="Start"
                                                FontAttributes="Bold"
                                                Text="{Binding Index, StringFormat='{0}.'}" />
                                            <Label
                                                FontAttributes="Bold"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Title}" />
                                        </StackLayout>
                                        <VerticalStackLayout>
                                            <Label 
                                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                                Margin="0,8,0,0"
                                                Text="Descripción" />
                                            <Label
                                                Style="{StaticResource OffLabelStyle}"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Description, TargetNullValue='---'}" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label
                                Style="{StaticResource CollectionPageEmptyViewLabelStyle}"
                                Margin="8"
                                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </CollectionView.EmptyView>
                        <CollectionView.Footer>
                            <StackLayout IsVisible="{Binding HasMoreItems}">
                                <Button
                                    Style="{StaticResource ListEntityPageLoadMoreButtonStyle}"
                                    Command="{Binding LoadMoreCommand, Mode=OneTime}" />
                            </StackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </Grid>
            </StackLayout>
            <common_ui_views:BusyView IsVisible="{Binding IsBusy}" />
        </Grid>
    </ContentPage.Content>
</common_ui_base_pages:BaseListEntityPage>