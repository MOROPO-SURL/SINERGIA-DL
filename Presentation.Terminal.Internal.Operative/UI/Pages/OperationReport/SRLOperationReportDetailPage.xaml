<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseDetailEntityPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Models.Page.OperationReport"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts.Models.OperationReport.DTOs;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts"
    xmlns:interop_document_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts.Models.Document.DTOs;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts"
    xmlns:common_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Constants;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_card_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views.Card;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_converters="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Converters;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Pages.OperationReport.SRLOperationReportDetailPage"
    x:TypeArguments="interop_dto_models:SRLOperationReportDetailDtoModel,local_page_models:SRLOperationReportDetailPageModel"
    x:DataType="local_page_models:SRLOperationReportDetailPageModel"
    Title="Detalles de Informe al CAM">
    <ContentPage.Resources>
        <ResourceDictionary>
            <common_ui_converters:DocumentBasicDtoModelToMaterialDesignFontIconTextConverter x:Key="DocumentBasicDtoModelToMaterialDesignFontIconTextConverter" />
            <common_ui_converters:OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter x:Key="OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Cierre del período" />
                        <Label Text="{Binding Model.Period, StringFormat='{0:MM-yyyy}'}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=3, ExtraLargeContainerColumn=4, LargeContainerColumn=6, SmallContainerColumn=12}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Entidad" />
                        <Label 
                            LineBreakMode="TailTruncation"
                            Text="{Binding Model.Organization.Name}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Descripción" />
                    <Label Text="{Binding Model.Description, TargetNullValue='---'}" />
                </VerticalStackLayout>
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,16,8,0">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        Text="Ingresos" />
                    <BoxView
                        Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                        Margin="0"
                        HeightRequest="2"
                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                </StackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Ingresos totales" />
                        <Label Text="{Binding Model.IncomeSummaryEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Por canales digitales" />
                        <Label Text="{Binding Model.IncomeEcommerceEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Deposito de efectivo" />
                        <Label Text="{Binding Model.IncomeBankDepositEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,16,8,0">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        Text="Gastos" />
                    <BoxView
                        Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                        Margin="0"
                        HeightRequest="2"
                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                </StackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Gastos totales" />
                        <Label Text="{Binding Model.SpendSummaryEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Pagado a privados" />
                        <Label Text="{Binding Model.SpendPrivateSectorEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Pagado a estatales" />
                        <Label Text="{Binding Model.SpendPublicSectorEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Pago a trabajadores" />
                        <Label Text="{Binding Model.HumanResourcePayloadEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,16,8,0">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        Text="Impuestos" />
                    <BoxView
                        Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                        Margin="0"
                        HeightRequest="2"
                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                </StackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Impuestos por ventas" />
                        <Label Text="{Binding Model.SellTaxEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Operativos y otros" />
                        <Label Text="{Binding Model.OperativeTaxEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,16,8,0">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        Text="Resultados" />
                    <BoxView
                        Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                        Margin="0"
                        HeightRequest="2"
                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                </StackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Utilidades / Pérdidas" />
                        <Label Text="{Binding Model.PeriodResultEntries, Converter={StaticResource OperationReportAccountingEntryCurrencyEnumerableKeyValuePairConverter}, StringFormat='{0:F2}'}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,16,8,0">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        Text="Recursos humanos" />
                    <BoxView
                        Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                        Margin="0"
                        HeightRequest="2"
                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                </StackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Personas contratadas" />
                        <Label Text="{Binding Model.EmployeeCount}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="De sexo femenino" />
                        <Label Text="{Binding Model.FemaleEmployeeCount}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Con necesidades especiales" />
                        <Label Text="{Binding Model.DiscapacityEmployeeCount}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,16,8,0">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        Text="Gestión energética" />
                    <BoxView
                        Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                        Margin="0"
                        HeightRequest="2"
                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                </StackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Consumo desde la red nacional" />
                        <Label Text="{Binding Model.GridEnergySpend, StringFormat='{0:F2} Kw'}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Generación renovable" />
                        <Label Text="{Binding Model.RenerenewableEnergyGeneration, StringFormat='{0:F2} Kw'}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Entrega renovable a la red" />
                        <Label Text="{Binding Model.RenerenewableEnergyExportation, StringFormat='{0:F2} Kw'}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,16,8,0">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        Text="Documentos adjuntos" />
                    <BoxView
                        Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                        Margin="0"
                        HeightRequest="2"
                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                </StackLayout>
                <CollectionView ItemsSource="{Binding Model.Documents}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout 
                            Orientation="Vertical" 
                            Span="2" 
                            HorizontalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" 
                            VerticalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Behaviors>
                        <common_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior 
                            ItemSpacing="{Static common_constants:ListEntityPageConstants.ADAPTABLE_GRIDITESMLAYOUT_COLLECTIONVIEW_BEHAVIOR_ITEMSSPACING}" 
                            ItemWidth="{Static common_constants:CardViewSizeConstants.DOCUMENT_DEFAULT_CARD_VIEW_WIDTH}" />
                    </CollectionView.Behaviors>
                    <CollectionView.EmptyView>
                        <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" Padding="8,0,8,8" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="interop_document_dto_models:DocumentBasicDtoModel">
                            <Frame 
                                HeightRequest="{Static common_constants:CardViewSizeConstants.DOCUMENT_DEFAULT_CARD_VIEW_HEIGHT}"
                                Padding="0">
                                <StackLayout Orientation="Horizontal">
                                    <Grid
                                        WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                                        BackgroundColor="DimGray">
                                        <Label
                                            HorizontalOptions="Center" VerticalOptions="Center"
                                            Text="{Binding Converter={StaticResource DocumentBasicDtoModelToMaterialDesignFontIconTextConverter}}"
                                            TextColor="White"
                                            FontSize="80"
                                            FontFamily="MaterialDesignIcons" />
                                    </Grid>
                                    <Grid 
                                        HorizontalOptions="FillAndExpand"
                                        Padding="16"
                                        ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <VerticalStackLayout
                                            Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                            Spacing="2">
                                            <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                                            <Label Text="{Binding Name}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout
                                            Grid.Column="0" Grid.Row="1"
                                            Spacing="2">
                                            <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo" />
                                            <Label Text="{Binding Extension}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout
                                            Grid.Column="1" Grid.Row="1"
                                            Spacing="2">
                                            <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tamaño" />
                                            <Label Text="{Binding Length, StringFormat='{0} bytes'}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Button
                                        Style="{StaticResource FontIconImageButtonStyle}"
                                        HorizontalOptions="End" VerticalOptions="Start"
                                        Margin="8"
                                        Text="&#xF1DA;"
                                        Clicked="DocumentDownloadButton_Clicked" />
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</common_ui_base_pages:BaseDetailEntityPage>