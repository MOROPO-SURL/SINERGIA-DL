<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseConfigurationEntityPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_configuration_page_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Internal.Operative.Models.Page.Macroprogram.Configuration"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.Macroprogram.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    x:Class="MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Internal.Operative.UI.Pages.Macroprogram.Configuration.MacroprogramConfigurationPage"
    x:TypeArguments="interop_dto_models:MacroprogramBasicDtoModel,interop_dto_models:MacroprogramDetailDtoModel,local_configuration_page_models:MacroprogramConfigurationPageModel"
    x:DataType="local_configuration_page_models:MacroprogramConfigurationPageModel"
    Shell.TabBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Command="{Binding ApplyCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xf12c;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Command="{Binding CancelCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons"
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xf156;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Grid
                        WidthRequest="108"
                        ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Número" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Index}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Value="{Binding Index}" />
                    </Grid>
                    <VerticalStackLayout 
                        HorizontalOptions="FillAndExpand"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Título" />
                        <Entry Text="{Binding Title}" />
                        <Label>
                            <Label.Behaviors>
                                <common_ui_behaviors:ValidationMessageLabelBehavior 
                                    TargetValidationPropertyName="{Static local_configuration_page_models:MacroprogramConfigurationPageModel.TitleValidableProperty}"
                                    InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                            </Label.Behaviors>
                        </Label>
                    </VerticalStackLayout>
                </StackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descripción (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="200" />
                    <Label>
                        <Label.Behaviors>
                            <common_ui_behaviors:ValidationMessageLabelBehavior 
                                TargetValidationPropertyName="{Static local_configuration_page_models:MacroprogramConfigurationPageModel.DescriptionValidableProperty}"
                                InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                        </Label.Behaviors>
                    </Label>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</common_ui_base_pages:BaseConfigurationEntityPage>