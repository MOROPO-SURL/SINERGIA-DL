<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseConfigurationEntityPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_configuration_page_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Internal.Operative.Models.Page.StrategicProject.Configuration"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.StrategicProject.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    xmlns:common_ui_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.Models;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_converters="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Converters;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Terminal.Internal.Operative.UI.Pages.StrategicProject.Configuration.StrategicProjectConfigurationPage"
    x:TypeArguments="interop_dto_models:StrategicProjectBasicDtoModel,interop_dto_models:StrategicProjectDetailDtoModel,local_configuration_page_models:StrategicProjectConfigurationPageModel"
    x:DataType="local_configuration_page_models:StrategicProjectConfigurationPageModel"
    Shell.TabBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Command="{Binding ApplyCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xf12c;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Command="{Binding CancelCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons"
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xf156;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                    <Entry Text="{Binding Name}" />
                    <Label>
                        <Label.Behaviors>
                            <common_ui_behaviors:ValidationMessageLabelBehavior 
                                TargetValidationPropertyName="{Static local_configuration_page_models:StrategicProjectConfigurationPageModel.NameValidableProperty}"
                                InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                        </Label.Behaviors>
                    </Label>
                </VerticalStackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=8}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo" />
                        <Picker 
                            ItemsSource="{Binding AvailableKinds}"
                            ItemDisplayBinding="{Binding Path=Name}"
                            SelectedItem="{Binding Kind}" />
                        <Label>
                            <Label.Behaviors>
                                <common_ui_behaviors:ValidationMessageLabelBehavior 
                                    TargetValidationPropertyName="{Static local_configuration_page_models:StrategicProjectConfigurationPageModel.KindValidableProperty}"
                                    InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                            </Label.Behaviors>
                        </Label>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=10, ExtraLargeContainerColumn=9, LargeContainerColumn=8, SmallContainerColumn=12}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Programa" />
                        <Picker 
                            ItemsSource="{Binding AvailablePrograms}"
                            ItemDisplayBinding="{Binding Path=Name}"
                            SelectedItem="{Binding Program}" />
                        <Label>
                            <Label.Behaviors>
                                <common_ui_behaviors:ValidationMessageLabelBehavior 
                                    TargetValidationPropertyName="{Static local_configuration_page_models:StrategicProjectConfigurationPageModel.ProgramValidableProperty}"
                                    InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                            </Label.Behaviors>
                        </Label>
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descripción (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="200" />
                    <Label>
                        <Label.Behaviors>
                            <common_ui_behaviors:ValidationMessageLabelBehavior 
                                TargetValidationPropertyName="{Static local_configuration_page_models:StrategicProjectConfigurationPageModel.DescriptionValidableProperty}"
                                InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                        </Label.Behaviors>
                    </Label>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}" />
                <FlexLayout Wrap="Wrap">
                    <Grid Style="{StaticResource FormFlexWrappedChildGridStyle}">
                        <Grid.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=1, ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}" />
                        </Grid.Behaviors>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Priority}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Priority}" />
                    </Grid>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</common_ui_base_pages:BaseConfigurationEntityPage>