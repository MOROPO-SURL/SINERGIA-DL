<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseConfigurationEntityPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Constants"
    xmlns:local_configuration_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Models.Page.StrategicProject.Configuration"
    xmlns:local_ui_card_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Views.Card"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.StrategicProject.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    xmlns:common_ui_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_card_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views.Card;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_converters="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Converters;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Pages.StrategicProject.Configuration.StrategicProjectConfigurationPage"
    x:TypeArguments="interop_dto_models:StrategicProjectDetailDtoModel,interop_dto_models:StrategicProjectDetailDtoModel,local_configuration_page_models:StrategicProjectConfigurationPageModel"
    x:DataType="local_configuration_page_models:StrategicProjectConfigurationPageModel"
    Shell.TabBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Command="{Binding ApplyCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xf12c;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Command="{Binding CancelCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons"
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xf156;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                    <Entry Text="{Binding Name}" />
                    <Label>
                        <Label.Behaviors>
                            <common_ui_behaviors:ValidationMessageLabelBehavior 
                                TargetValidationPropertyName="{Static local_configuration_page_models:StrategicProjectConfigurationPageModel.NameValidableProperty}"
                                InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                        </Label.Behaviors>
                    </Label>
                </VerticalStackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=8}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo" />
                        <Picker 
                            ItemsSource="{Binding AvailableKinds}"
                            ItemDisplayBinding="{Binding Path=Name}"
                            SelectedItem="{Binding Kind}" />
                        <Label>
                            <Label.Behaviors>
                                <common_ui_behaviors:ValidationMessageLabelBehavior 
                                    TargetValidationPropertyName="{Static local_configuration_page_models:StrategicProjectConfigurationPageModel.KindValidableProperty}"
                                    InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                            </Label.Behaviors>
                        </Label>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=10, ExtraLargeContainerColumn=9, LargeContainerColumn=8, SmallContainerColumn=12}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Programa" />
                        <Picker 
                            ItemsSource="{Binding AvailablePrograms}"
                            ItemDisplayBinding="{Binding Path=Name}"
                            SelectedItem="{Binding Program}" />
                        <Label>
                            <Label.Behaviors>
                                <common_ui_behaviors:ValidationMessageLabelBehavior 
                                    TargetValidationPropertyName="{Static local_configuration_page_models:StrategicProjectConfigurationPageModel.ProgramValidableProperty}"
                                    InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                            </Label.Behaviors>
                        </Label>
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Objetivo" />
                    <Editor Text="{Binding Objective}" HeightRequest="100" />
                    <Label>
                        <Label.Behaviors>
                            <common_ui_behaviors:ValidationMessageLabelBehavior 
                                TargetValidationPropertyName="{Static local_configuration_page_models:StrategicProjectConfigurationPageModel.ObjectiveValidableProperty}"
                                InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                        </Label.Behaviors>
                    </Label>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descripción (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="200" />
                    <Label>
                        <Label.Behaviors>
                            <common_ui_behaviors:ValidationMessageLabelBehavior 
                                TargetValidationPropertyName="{Static local_configuration_page_models:StrategicProjectConfigurationPageModel.DescriptionValidableProperty}"
                                InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                        </Label.Behaviors>
                    </Label>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Objetivos específicos" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Command="{Binding CreateSpecificObjectiveCommand, Mode=OneTime}" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="DimGray" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding SpecificObjectives}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_dto_models:SpecificObjectiveProjectDetailDtoModel">
                                        <Frame Padding="8">
                                            <StackLayout Orientation="Horizontal" Spacing="8">
                                                <Label
                                                    Margin="8"
                                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                                    LineBreakMode="TailTruncation">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                FontAttributes="Bold"
                                                                Text="{Binding Index, StringFormat='{0}.'}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding Content}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Button
                                                    Style="{StaticResource FontIconImageButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Text="&#xF2FD;"
                                                    Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DetailSpecificObjectiveCommand, Mode=OneTime}"
                                                    CommandParameter="{Binding Mode=OneTime}" />
                                                <Button
                                                    Style="{StaticResource FontIconImageButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Text="&#xF90B;"
                                                    Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.UpdateSpecificObjectiveCommand, Mode=OneTime}"
                                                    CommandParameter="{Binding Mode=OneTime}" />
                                                <Button
                                                    Style="{StaticResource DangerKindFontIconImageButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Text="&#xFA78;"
                                                    Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DeleteSpecificObjectiveCommand, Mode=OneTime}"
                                                    CommandParameter="{Binding Mode=OneTime}" />
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Indicadores" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Command="{Binding CreateIndicatorCommand, Mode=OneTime}" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="DimGray" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding Indicators}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_dto_models:IndicatorDetailDtoModel">
                                        <Frame Padding="8">
                                            <StackLayout Orientation="Horizontal" Spacing="8">
                                                <Label 
                                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                                    Margin="8"
                                                    LineBreakMode="TailTruncation">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Name}" />
                                                            <Span Text="{Binding Alias, TargetNullValue='', StringFormat=' ({0})'}" />
                                                            <Span Text="{Binding UnitMeasurement.Name, StringFormat=', {0}'}" />
                                                            <Span Text="{Binding UnitMeasurement.Symbol, StringFormat=' ({0})'}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>                                                                                                                                      
                                                </Label>
                                                <Button
                                                    Style="{StaticResource FontIconImageButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Text="&#xF2FD;"
                                                    Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DetailIndicatorCommand, Mode=OneTime}"
                                                    CommandParameter="{Binding Mode=OneTime}" />
                                                <Button
                                                    Style="{StaticResource FontIconImageButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Text="&#xF90B;"
                                                    Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.UpdateIndicatorCommand, Mode=OneTime}"
                                                    CommandParameter="{Binding Mode=OneTime}" />
                                                <Button
                                                    Style="{StaticResource DangerKindFontIconImageButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Text="&#xFA78;"
                                                    Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DeleteIndicatorCommand, Mode=OneTime}"
                                                    CommandParameter="{Binding Mode=OneTime}" />
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Macroprogramas" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Command="{Binding AddMacroprogramCommand, Mode=OneTime}" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="DimGray" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding Macroprograms}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout 
                                        Orientation="Vertical" 
                                        Span="2" 
                                        HorizontalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" 
                                        VerticalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.Behaviors>
                                    <common_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior 
                                        ItemSpacing="{Static common_constants:ListEntityPageConstants.ADAPTABLE_GRIDITESMLAYOUT_COLLECTIONVIEW_BEHAVIOR_ITEMSSPACING}" 
                                        ItemWidth="{Static local_constants:CardViewSizeConstants.MACROPROGRAM_DEFAULT_CARD_VIEW_WIDTH}" />  
                                </CollectionView.Behaviors>
                                <CollectionView.EmptyView>
                                    <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local_ui_card_views:MacroprogramCardView 
                                                Grid.Column="0"
                                                HeightRequest="{Static local_constants:CardViewSizeConstants.MACROPROGRAM_DEFAULT_CARD_VIEW_HEIGHT}"/>
                                            <Button
                                                Grid.Column="1"
                                                Style="{StaticResource DangerKindFontIconImageButtonStyle}"
                                                VerticalOptions="Start"
                                                Text="&#xFA78;"
                                                Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.RemoveMacroprogramCommand, Mode=OneTime}"
                                                CommandParameter="{Binding Mode=OneTime}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <BoxView Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}" />
                <FlexLayout Wrap="Wrap">
                    <Grid Style="{StaticResource FormFlexWrappedChildGridStyle}">
                        <Grid.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=1, ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}" />
                        </Grid.Behaviors>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Priority}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Priority}" />
                    </Grid>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</common_ui_base_pages:BaseConfigurationEntityPage>