<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseListEntityPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Constants"
    xmlns:local_view_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Models.View"
    xmlns:local_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Models.Page.StrategicProject"
    xmlns:common_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Constants;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Pages.StrategicProject.IndicatorStateListPage"
    x:TypeArguments="local_view_models:StrategicProjectIndicatorStateViewModel,local_page_models:IndicatorStateListPageModel"
    x:DataType="local_page_models:IndicatorStateListPageModel"
    Shell.TabBarIsVisible="False"
    Title="Actualización de indicadores de Proyecto"
    IsEnabled="{Binding IsEnabled}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Command="{Binding ReloadCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xF450;"  />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <StackLayout Orientation="Vertical">
                <Grid VerticalOptions="FillAndExpand">
                    <CollectionView
                        x:Name="ItemsCollectionView"
                        Style="{StaticResource ListEntityPageCollectionViewStyle}"
                        ItemsSource="{Binding Items}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout 
                                Orientation="Vertical" 
                                Span="2" 
                                HorizontalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" 
                                VerticalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <common_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior 
                                ItemSpacing="{Static common_constants:ListEntityPageConstants.ADAPTABLE_GRIDITESMLAYOUT_COLLECTIONVIEW_BEHAVIOR_ITEMSSPACING}" 
                                ItemWidth="{Static local_constants:CardViewSizeConstants.INDICATOR_STATE_CARD_VIEW_WIDTH}" />
                        </CollectionView.Behaviors>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local_view_models:StrategicProjectIndicatorStateViewModel">
                                <Frame HeightRequest="{Static local_constants:CardViewSizeConstants.INDICATOR_STATE_CARD_VIEW_HEIGHT}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <VerticalStackLayout 
                                            Grid.Column="0"
                                            Margin="4,0,0,0"
                                            VerticalOptions="Center">
                                            <Label
                                                VerticalOptions="Center"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Indicator.Name, Mode=OneTime}" />
                                            <Label>
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span FontAttributes="Bold" Text="Meta: " />
                                                        <Span Text="{Binding TargetMilestone.Amount, Mode=OneTime}" />
                                                        <Span Text="{Binding Indicator.UnitMeasurement.Symbol, StringFormat=' {0}', Mode=OneTime}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout 
                                            Grid.Column="1"
                                            VerticalOptions="Center">
                                            <Label 
                                                FontAttributes="Bold"
                                                Text="Estado" />
                                            <Label>
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding LastChange.Amount, StringFormat='{0:F2}', FallbackValue='0.00'}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Indicator.UnitMeasurement.Symbol, Mode=OneTime}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Button
                                            Style="{StaticResource FontIconImageButtonStyle}"
                                            Grid.Column="2"
                                            VerticalOptions="Center"
                                            Text="&#xF90B;"
                                            Clicked="AddChangeButton_Clicked" />
                                        <Button
                                            Style="{StaticResource FontIconImageButtonStyle}"
                                            IsEnabled="{Binding LastChange, Converter={StaticResource IsNotNullConverter}}"
                                            Grid.Column="3"
                                            VerticalOptions="Center"
                                            Text="&#xF2FD;"
                                            Clicked="DetailLastChangeButton_Clicked" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </StackLayout>
            <common_ui_views:BusyView IsVisible="{Binding IsBusy}" />
        </Grid>
    </ContentPage.Content>
</common_ui_base_pages:BaseListEntityPage>