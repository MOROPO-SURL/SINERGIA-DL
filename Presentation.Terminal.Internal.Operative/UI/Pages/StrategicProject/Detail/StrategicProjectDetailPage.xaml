<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseDetailEntityPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Constants"
    xmlns:local_detail_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Models.Page.StrategicProject.Detail"
    xmlns:local_ui_card_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Views.Card"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts.Models.StrategicProject.DTOs;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts"
    xmlns:interop_trace_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts.Models.StrategicProjectTrace.DTOs;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts"
    xmlns:common_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Constants;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_converters="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Converters;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Pages.StrategicProject.Detail.StrategicProjectDetailPage"
    x:TypeArguments="interop_dto_models:StrategicProjectDetailDtoModel,local_detail_page_models:StrategicProjectDetailPageModel"
    x:DataType="local_detail_page_models:StrategicProjectDetailPageModel"
    Shell.TabBarIsVisible="False"
    Title="Detalles de Proyecto">
    <ContentPage.Resources>
        <ResourceDictionary>
            <common_ui_converters:StringToLocalizedStringConverter x:Key="StringToLocalizedStringConverter" />

            <communitytoolkit_converters:IsNullConverter x:Key="IsNullConverter" />
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Modificar"
            Command="{Binding ModifyCommand, Mode=OneTime}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons"  
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xF90B;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Eliminar"
            Command="{Binding RemoveCommand, Mode=OneTime}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xFA79;"  />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}"
                        Text="Nombre" />
                    <Label
                        Style="{StaticResource ValuePropertyLabelStyle}"
                        Text="{Binding Model.Name}"/>
                </VerticalStackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=8}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo" />
                        <Label Text="{Binding Model.Kind.Name}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=10, ExtraLargeContainerColumn=9, LargeContainerColumn=8, SmallContainerColumn=12}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Programa" />
                        <Label Text="{Binding Model.Program.Name}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}"
                        Text="Objetivo" />
                    <Label
                        Style="{StaticResource ValuePropertyLabelStyle}"
                        Text="{Binding Model.Objective}" />
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Objetivos específicos" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <CollectionView ItemsSource="{Binding Model.SpecificObjectives}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="interop_dto_models:SpecificObjectiveProjectDetailDtoModel">
                                <Frame Padding="8">
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label
                                            Margin="8"
                                            HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                            LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontAttributes="Bold"
                                                        Text="{Binding Index, StringFormat='{0}.'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding Content}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Button
                                            Style="{StaticResource FontIconImageButtonStyle}"
                                            VerticalOptions="Center"
                                            Text="&#xF2FD;"
                                            Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DetailSpecificObjectiveCommand, Mode=OneTime}"
                                            CommandParameter="{Binding Mode=OneTime}" />
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Indicadores" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <CollectionView ItemsSource="{Binding Model.Indicators}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="interop_dto_models:IndicatorDetailDtoModel">
                                <Frame Padding="8">
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label 
                                            HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                            Margin="8"
                                            LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Name}" />
                                                    <Span Text="{Binding Alias, TargetNullValue='', StringFormat=' ({0})'}" />
                                                    <Span Text="{Binding UnitMeasurement.Name, StringFormat=', {0}'}" />
                                                    <Span Text="{Binding UnitMeasurement.Symbol, StringFormat=' ({0})'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Button
                                            Style="{StaticResource FontIconImageButtonStyle}"
                                            VerticalOptions="Center"
                                            Text="&#xF2FD;"
                                            Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DetailIndicatorCommand, Mode=OneTime}"
                                            CommandParameter="{Binding Mode=OneTime}" />
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}"
                        Text="Descripción" />
                    <Label
                        Style="{StaticResource ValuePropertyLabelStyle}"
                        Text="{Binding Model.Description, TargetNullValue='---'}" />
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Macroprogramas" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <CollectionView ItemsSource="{Binding Model.Macroprograms}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout 
                                Orientation="Vertical" 
                                Span="2" 
                                HorizontalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" 
                                VerticalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <common_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior 
                                ItemSpacing="{Static common_constants:ListEntityPageConstants.ADAPTABLE_GRIDITESMLAYOUT_COLLECTIONVIEW_BEHAVIOR_ITEMSSPACING}" 
                                ItemWidth="{Static local_constants:CardViewSizeConstants.MACROPROGRAM_DEFAULT_CARD_VIEW_WIDTH}" />          
                        </CollectionView.Behaviors>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <local_ui_card_views:MacroprogramCardView HeightRequest="{Static local_constants:CardViewSizeConstants.MACROPROGRAM_DEFAULT_CARD_VIEW_HEIGHT}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label 
                        Style="{StaticResource CaptionPropertyLabelStyle}"
                        Text="Prioridad" />
                    <Label
                        Style="{StaticResource ValuePropertyLabelStyle}"
                        Text="{Binding Model.Priority}" />
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Historial de cambios" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <Button
                        IsVisible="{Binding Traces, Converter={StaticResource IsNullConverter}}"
                        HorizontalOptions="Center"
                        Text="Mostrar"
                        Command="{Binding FetchTraceCommand, Mode=OneTime}" />
                    <CollectionView 
                        IsVisible="{Binding Traces, Converter={StaticResource IsNotNullConverter}}"
                        ItemsSource="{Binding Traces}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="interop_trace_dto_models:StrategicProjectTraceDetailDtoModel">
                                <Grid ColumnSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Column="0" Grid.RowSpan="3"
                                        VerticalOptions="Center"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="48"
                                        Text="&#xF0226;"
                                        TextColor="DimGray" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        FontAttributes="Bold"
                                        Text="{Binding Kind, Converter={StaticResource StringToLocalizedStringConverter}}" />
                                    <Label
                                        Grid.Column="1" Grid.Row="1"
                                        Text="{Binding Author}" />
                                    <Label
                                        Grid.Column="1" Grid.Row="2"
                                        FontAttributes="Italic"
                                        Text="{Binding CreatedAt}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button
                        IsVisible="{Binding Traces, Converter={StaticResource IsNotNullConverter}}"
                        HorizontalOptions="Center"
                        Text="Actualizar"
                        Command="{Binding FetchTraceCommand, Mode=OneTime}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</common_ui_base_pages:BaseDetailEntityPage>