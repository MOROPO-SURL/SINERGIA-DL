<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseBindingContextedContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.Models.Page"
    xmlns:common_ui_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Pages.EnvironmentSummaryPage"
    x:TypeArguments="local_page_models:EnvironmentSummaryPageModel"
    x:DataType="local_page_models:EnvironmentSummaryPageModel"
    Title="Entorno complementario">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <communitytoolkit_converters:BoolToObjectConverter 
                x:Key="BoolToColor" 
                TrueObject="#45A049"            
                FalseObject="#E65100" />
            <communitytoolkit_converters:BoolToObjectConverter 
                x:Key="IsEnvReadeyToGlyph" 
                TrueObject="&#xF790;"
                FalseObject="&#xFCC1;" />
            <communitytoolkit_converters:BoolToObjectConverter 
                x:Key="HasAnyToGlyph" 
                TrueObject="&#xFE70;"
                FalseObject="&#xF026;" />
            <communitytoolkit_converters:BoolToObjectConverter 
                x:Key="IsEnvReadeyToTitle" 
                TrueObject="Configuración mínima del entorno complementario completada"
                FalseObject="Se requiere configuración mínima del entorno complementario" />
            <communitytoolkit_converters:BoolToObjectConverter 
                x:Key="BoolToTitle" 
                TrueObject="Al menos una definida"
                FalseObject="0 definidas" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    Glyph="&#xF450;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Frame Margin="8">
                        <VerticalStackLayout>
                            <Label
                                HorizontalTextAlignment="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="96"
                                TextColor="{Binding IsEnvironmentReady, Converter={StaticResource BoolToColor}}"
                                Text="{Binding IsEnvironmentReady, Converter={StaticResource IsEnvReadeyToGlyph}}" />
                            <Label
                                HorizontalTextAlignment="Center"
                                FontSize="Medium"
                                TextColor="{Binding IsEnvironmentReady, Converter={StaticResource BoolToColor}}"
                                Text="{Binding IsEnvironmentReady, Converter={StaticResource IsEnvReadeyToTitle}}" />
                            <BoxView
                                Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                                Margin="0,24"
                                HeightRequest="2" />
                            <FlexLayout Wrap="Wrap">
                                <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                                    <VerticalStackLayout.Behaviors>
                                        <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                            ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}" />
                                    </VerticalStackLayout.Behaviors>
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="48"
                                        Text="&#xF63E;" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        Text="Tipos de Caract. Terr." />
                                    <Label
                                        HorizontalOptions="Center"
                                        Margin="0,8,0,0"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="36"
                                        TextColor="{Binding HasAnyFeatureKind, Converter={StaticResource BoolToColor}}"
                                        Text="{Binding HasAnyFeatureKind, Converter={StaticResource HasAnyToGlyph}}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        TextColor="{Binding HasAnyFeatureKind, Converter={StaticResource BoolToColor}}"
                                        Text="{Binding HasAnyFeatureKind, Converter={StaticResource BoolToTitle}}" />
                                    <Button
                                        HorizontalOptions="Center"
                                        Margin="0,8,0,0"
                                        Text="Administrar"
                                        Clicked="FeatureKindAdminButton_Clicked" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                                    <VerticalStackLayout.Behaviors>
                                        <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                            ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}" />
                                    </VerticalStackLayout.Behaviors>
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="48"
                                        Text="&#xF990;" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        Text="Tipos de Entidad" />
                                    <Label
                                        HorizontalOptions="Center"
                                        Margin="0,8,0,0"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="36"
                                        TextColor="{Binding HasAnyOrganizationKind, Converter={StaticResource BoolToColor}}"
                                        Text="{Binding HasAnyOrganizationKind, Converter={StaticResource HasAnyToGlyph}}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        TextColor="{Binding HasAnyOrganizationKind, Converter={StaticResource BoolToColor}}"
                                        Text="{Binding HasAnyOrganizationKind, Converter={StaticResource BoolToTitle}}" />
                                    <Button
                                        HorizontalOptions="Center"
                                        Margin="0,8,0,0"
                                        Text="Administrar"
                                        Clicked="OrganizationKindAdminButton_Clicked"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                                    <VerticalStackLayout.Behaviors>
                                        <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                            ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}" />
                                    </VerticalStackLayout.Behaviors>
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="48"
                                        Text="&#xF00AB;" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        Text="Tipos de Proyecto" />
                                    <Label
                                        HorizontalOptions="Center"
                                        Margin="0,8,0,0"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="36"
                                        TextColor="{Binding HasAnyProjectKind, Converter={StaticResource BoolToColor}}"
                                        Text="{Binding HasAnyProjectKind, Converter={StaticResource HasAnyToGlyph}}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        TextColor="{Binding HasAnyProjectKind, Converter={StaticResource BoolToColor}}"
                                        Text="{Binding HasAnyProjectKind, Converter={StaticResource BoolToTitle}}" />
                                    <Button
                                        HorizontalOptions="Center"
                                        Margin="0,8,0,0"
                                        Text="Administrar"
                                        Clicked="StrategicProjectKindAdminButton_Clicked" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                                    <VerticalStackLayout.Behaviors>
                                        <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                            ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}" />
                                    </VerticalStackLayout.Behaviors>
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="48"
                                        Text="{StaticResource IconGlyphUnitMeasurement}" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        Text="Unidades de medida" />
                                    <Label
                                        HorizontalOptions="Center"
                                        Margin="0,8,0,0"
                                        FontFamily="MaterialDesignIcons"
                                        FontSize="36"
                                        TextColor="{Binding HasAnyProjectKind, Converter={StaticResource BoolToColor}}"
                                        Text="{Binding HasAnyProjectKind, Converter={StaticResource HasAnyToGlyph}}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        TextColor="{Binding HasAnyProjectKind, Converter={StaticResource BoolToColor}}"
                                        Text="{Binding HasAnyProjectKind, Converter={StaticResource BoolToTitle}}" />
                                    <Button
                                        Style="{StaticResource PrimaryKindButtonStyle}"
                                        HorizontalOptions="Center"
                                        Margin="0,8,0,0"
                                        Text="Gestionar"
                                        Clicked="UnitMeasurementManageButton_Clicked" />
                                </VerticalStackLayout>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</common_ui_base_pages:BaseBindingContextedContentPage>