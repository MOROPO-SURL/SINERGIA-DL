<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Shells.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_ui_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Internal.Operative.UI.Pages"
    xmlns:common_ui_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    Title="Navegación"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource OffBlack}}">
    <Shell.FlyoutBehavior>
        <OnIdiom Default="Flyout" Desktop="Locked" />
    </Shell.FlyoutBehavior>
    <Shell.FlyoutHeader>
        <Grid Padding="0,0,0,16">
            <Image 
                Source="shell_cmg_header.jpg" />
            <Image 
                VerticalOptions="End"
                Source="{AppThemeBinding Light='shell_header_frame_artwork_light.png', Dark='shell_header_frame_artwork_dark.png'}" />
        </Grid>
    </Shell.FlyoutHeader>
    <ShellContent
        Title="Panel de control"
        Route="MainPage"
        ContentTemplate="{DataTemplate local_ui_pages:MainPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphDashboard}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Resumen">
        <MenuFlyoutItem.IconImageSource>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphRhombusMedium}" />
        </MenuFlyoutItem.IconImageSource>
    </MenuFlyoutItem>
    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Dianóstico estratégico"
            ContentTemplate="{DataTemplate common_ui_pages:DiagnosticSummaryPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphContext}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Componentes de la estrategia"
            ContentTemplate="{DataTemplate common_ui_pages:StrategySummaryPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphEDL}" />
            </ShellContent.Icon>
        </ShellContent>
    </FlyoutItem>
    <MenuFlyoutItem Text="Estrategia">
        <MenuFlyoutItem.IconImageSource>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphRhombusMedium}" />
        </MenuFlyoutItem.IconImageSource>
    </MenuFlyoutItem>
    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Caracter. del territ."
            ContentTemplate="{DataTemplate local_ui_pages:FeaturesManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphFeature}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Objetivos"
            ContentTemplate="{DataTemplate local_ui_pages:ObjectivesManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphObjective}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Barreras"
            ContentTemplate="{DataTemplate local_ui_pages:TerritorialBarriersManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphBarrier}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Potencialidades"
            ContentTemplate="{DataTemplate local_ui_pages:TerritoryPotentialsManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphPotential}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Políticas públicas"
            ContentTemplate="{DataTemplate local_ui_pages:PublicPoliciesManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphPublicPolicy}" />
            </ShellContent.Icon>
        </ShellContent>
    </FlyoutItem>
    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Ejes estratégicos"
            ContentTemplate="{DataTemplate local_ui_pages:StrategicAxesManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphAxe}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Líneas estratégicas"
            ContentTemplate="{DataTemplate local_ui_pages:StrategicLinesManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphLine}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Programas"
            ContentTemplate="{DataTemplate local_ui_pages:StrategicProgramsManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphProgram}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Ideas de proyecto"
            ContentTemplate="{DataTemplate local_ui_pages:StrategicProjectIdeasManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphProjectIdea}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Proyectos"
            ContentTemplate="{DataTemplate local_ui_pages:StrategicProjectsManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphProject}" />
            </ShellContent.Icon>
        </ShellContent>
    </FlyoutItem>
    <MenuFlyoutItem Text="Estado de indicadores">
        <MenuFlyoutItem.IconImageSource>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphRhombusMedium}" />
        </MenuFlyoutItem.IconImageSource>
    </MenuFlyoutItem>
    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Objetivos"
            ContentTemplate="{DataTemplate local_ui_pages:ObjectiveListForIndicatorsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphObjective}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Programas"
            ContentTemplate="{DataTemplate local_ui_pages:StrategicProgramListForIndicatorsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphProgram}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Proyectos"
            ContentTemplate="{DataTemplate local_ui_pages:StrategicProjectListForIndicatorsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphProject}" />
            </ShellContent.Icon>
        </ShellContent>
    </FlyoutItem>
    <MenuFlyoutItem Text="Complementarios">
        <MenuFlyoutItem.IconImageSource>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphRhombusMedium}" />
        </MenuFlyoutItem.IconImageSource>
    </MenuFlyoutItem>
    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Macroprogramas"
            ContentTemplate="{DataTemplate local_ui_pages:MacroprogramsManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphMacroprograms}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Personas"
            ContentTemplate="{DataTemplate local_ui_pages:PersonsManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphPerson}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Entidades"
            ContentTemplate="{DataTemplate local_ui_pages:OrganizationsManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphOrganization}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Actividades económicas"
            ContentTemplate="{DataTemplate local_ui_pages:EconomicActivitiesManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphEconomicActivities}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Unidades de medida"
            Route="UnitMeasurementsManagementPage"
            ContentTemplate="{DataTemplate local_ui_pages:UnitMeasurementsManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                    Color="{AppThemeBinding Light=Black, Dark=White}" 
                    Glyph="{StaticResource IconGlyphUnitMeasurement}" />
            </ShellContent.Icon>
        </ShellContent>
    </FlyoutItem>
    <FlyoutItem 
        Title="Informes al CAM"
        FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphReport}" />
        </FlyoutItem.Icon>
        <ShellContent 
            Title="PDLs"
            ContentTemplate="{DataTemplate local_ui_pages:PDLOperationReportsListPage}" />
        <ShellContent 
            Title="MiPyMEs"
            ContentTemplate="{DataTemplate local_ui_pages:SRLOperationReportsListPage}" />
    </FlyoutItem>
    <FlyoutItem 
        Title="Acciones de responsabilidad social"
        FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphSocialResponsabilityActions}" />
        </FlyoutItem.Icon>
        <ShellContent 
            Title="PDLs"
            ContentTemplate="{DataTemplate local_ui_pages:PDLSocialResponsabilityActionsListPage}" />
        <ShellContent 
            Title="MiPyMEs"
            ContentTemplate="{DataTemplate local_ui_pages:SRLSocialResponsabilityActionsListPage}" />
    </FlyoutItem>
    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent             
            Title="Prioridades de asistencia social"
            ContentTemplate="{DataTemplate local_ui_pages:SocialSupportDemandsManagementPage}">
            <ShellContent.Icon>
                <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphSocialSupportDemands}" />
            </ShellContent.Icon>
        </ShellContent>
    </FlyoutItem>
    <MenuItem
        Text="Configuración"
        Clicked="ConfigurationMenuItem_Clicked">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphConfig}" />
        </MenuItem.IconImageSource>
    </MenuItem>
    <MenuItem
        Text="Centro de Ayuda"
        Clicked="HelpMenuItem_Clicked">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphHelp}" />
        </MenuItem.IconImageSource>
    </MenuItem>
    <MenuItem
        Text="Perfil de Usuario"
        Clicked="UserProfileMenuItem_Clicked">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphUserProfile}" />
        </MenuItem.IconImageSource>
    </MenuItem>
    <MenuItem
        Text="Salir del Sistema"
        Clicked="LogOutMenuItem_Clicked">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="{StaticResource FontMaterialDesignIcons}"
                Color="{AppThemeBinding Light=Black, Dark=White}" 
                Glyph="{StaticResource IconGlyphLogOut}" />
        </MenuItem.IconImageSource>
    </MenuItem>
</Shell>
