	  </Compile>
	  <Compile Update="UI\Pages\UserAuthenticationPage.xaml.cs">
	    <DependentUpon>UserAuthenticationPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="LocalizationResources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>LocalizationResources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

