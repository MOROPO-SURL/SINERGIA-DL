@using MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Web.BackOffice.Razor.Models.View.OrganizationKinds

@model OrganizationKindDetailViewModel

<dl class="mb-0">
    <dt>Nombre</dt>
    <dd>@Model.Name</dd>
    <dt>Perfil de Actor del Desarrollo</dt>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <dd>@Model.DevelopmentActorProfileKind</dd>
    }
    else
    {
        <dd>---</dd>
    }
    <dt>Descripción</dt>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <dd class="mb-0">@Model.Description</dd>
    }
    else
    {
        <dd class="mb-0">---</dd>
    }
</dl>