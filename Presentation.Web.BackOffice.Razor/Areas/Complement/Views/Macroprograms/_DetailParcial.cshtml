@using MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Web.BackOffice.Razor.Models.View.Macroprograms

@model MacroprogramDetailViewModel

<dl class="mb-0">
    <dt>Índice</dt>
    <dd>@Model.Index</dd>
    <dt>Título</dt>
    <dd>@Model.Title</dd>
    <dt>Descripción</dt>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <dd class="mb-0">@Model.Description</dd>
    }
    else
    {
        <dd class="mb-0">---</dd>
    }
</dl>