@using MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Web.BackOffice.Razor.Models.View.PublicPolicies

@model PublicPolicyDetailViewModel

<dl class="mb-0">
    <dt>Título</dt>
    <dd>@Model.Title</dd>
    <dt>Tipo</dt>
    <dd>@Model.Kind</dd>
    <dt>Descripción</dt>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <dd class="mb-0">@Model.Description</dd>
    }
    else
    {
        <dd class="mb-0">---</dd>
    }
</dl>