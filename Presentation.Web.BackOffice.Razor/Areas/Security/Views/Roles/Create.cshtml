@using MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Web.BackOffice.Razor.Models.View.Roles

@model RoleCreateViewModel

@{
    const string TITLE = "Agregar Rol";
    const string HEADER = "Administración de Roles";

    ViewData[SessionConstants.TITLE_DICTIONARY_KEY] = TITLE;
    ViewData[SessionConstants.HEADER_DICTIONARY_KEY] = HEADER;

    ViewData[SessionConstants.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel(
            "<i class=\"mdi mdi-monitor-dashboard\"></i> Panel de Control",
            Url.Action("Index", "Dashboard", new { Area = "management" })),
        new BreadcrumbViewModel(
            HEADER,
            Url.Action("index")),
        new BreadcrumbViewModel(TITLE)
    };

    Layout = "_BackendLayout";
}

<hr class="mt-0 mb-4" />

<form method="post" asp-action="create">
    @Html.ValidationSummary(true)

    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@TITLE</h5></div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>

            <fieldset>
                <legend class="border-bottom">Permisos</legend>
                <div>
                    @if (Model.GroupedSelectablePermissions!.Length > 0 || Model.UngroupedSelectablePermissions!.Length > 0)
                    {
                        var index = 0;

                        <ul>
                            <li>
                                <div class="row">
                                    @foreach (var item in Model.UngroupedSelectablePermissions!)
                                    {
                                        <div class="col-lg-4 col-md-6">
                                            @Html.EditorFor(model => item, "SelectionDescriptedStringIDItemInputViewModel", string.Format("SelectedPermissions[{0}]", index++))
                                        </div>
                                    }
                                </div>
                            </li>

                            @if (Model.GroupedSelectablePermissions.Length > 0)
                            {
                                foreach (var group in Model.GroupedSelectablePermissions!)
                                {
                                    <li>
                                        <fieldset>
                                            <legend class="border-bottom">@group.Key</legend>
                                            <div class="row">
                                                @foreach (var item in group.Value)
                                                {
                                                    <div class="col-lg-4 col-md-6">
                                                        @Html.EditorFor(model => item, "SelectionDescriptedStringIDItemInputViewModel", string.Format("SelectedPermissions[{0}]", index++))
                                                    </div>
                                                }
                                            </div>
                                        </fieldset>
                                    </li>
                                }
                            }
                        </ul>
                    }
                    else
                    {
                        <div>Sin elementos que mostrar.</div>
                    }
                </div>
            </fieldset>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><span class="mdi mdi-check-underline mr-1"></span>Aplicar</button>
            <a class="btn btn-outline-secondary" asp-action="index"><span class="mdi mdi-window-close mr-1"></span>Cancelar</a>
        </div>
    </div>
</form>