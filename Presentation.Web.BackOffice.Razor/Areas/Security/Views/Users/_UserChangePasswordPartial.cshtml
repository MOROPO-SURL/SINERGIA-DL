@using MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Web.BackOffice.Razor.Models.View.Users

@model UserChangePasswordViewModel

<div class="modal fade" id="change-password-@Model.UserId" tabindex="-1" role="dialog" aria-labelledby="change-password-@Model.UserId-lable" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form method="post" id="@Html.Raw($"changePasswordForm{Model.UserId}")" class="modal-content" asp-action="changepassword">
            @Html.HiddenFor(model => model. UserId)

            <div class="modal-header">
                <h5 class="modal-title" id="change-password-@Model.UserId-lable">Cambiar Contraseña</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6" style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.UserId, new { @class = "control-label" })
                        <div>@Model.UserId</div>
                    </div>
                    <div class="col-sm-6" style="margin-bottom: 20px;">            
                        <div class="checkbox">
                            <label>
                                @Html.EditorFor(model => model.IsChangePasswordRequired) Debe cambiar la contraseña?
                            </label>
                        </div>
                    </div> 
                </div>            
                <div class="row">
                    <div class="col-sm-6" style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.NewPassword, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.NewPassword, new { @class = "form-control" })                  
                    </div>
                    <div class="col-sm-6" style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.ConfirmPassword, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.ConfirmPassword, new { @class = "form-control" })                 
                    </div>
                </div>
            </div>
            <div class="modal-footer"style="margin-top: 0;">
                <button type="submit" class="btn btn-primary"><span class="mdi mdi-check-underline mr-1"></span>Aplicar</button>
                <a class="btn btn-outline-secondary" asp-action="index"><span class="mdi mdi-window-close mr-1"></span>Cancelar</a>
            </div>
        </form>
    </div>
</div>