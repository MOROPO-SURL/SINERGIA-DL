@using MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Web.BackOffice.Razor.Models.View.ApiKeys

@model ApiKeyUpdateViewModel

@{
    const string TITLE = "Modificar Llave API";
    const string HEADER = "Administración de Llaves API";

    ViewData[SessionConstants.TITLE_DICTIONARY_KEY] = TITLE;
    ViewData[SessionConstants.HEADER_DICTIONARY_KEY] = HEADER;

    ViewData[SessionConstants.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel(
            "<i class=\"mdi mdi-monitor-dashboard\"></i> Panel de Control",
            Url.Action("Index", "Dashboard", new { Area = "management" })),
        new BreadcrumbViewModel(
            HEADER,
            Url.Action("index")),
        new BreadcrumbViewModel(TITLE)
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link href="~/vendor/gijgo/combined/css/gijgo.min.css" rel="stylesheet" type="text/css" />
}

@section scripts {
    <script src="~/vendor/gijgo/combined/js/gijgo.min.js" type="text/javascript"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#ExpireAt').datepicker({
                uiLibrary: 'bootstrap4',
                modal: true,
                header: true,
                footer: true,
                format: 'dd/mm/yyyy',
                value: '@Model.ExpireAt.ToShortDateString()'
            });
        });
    </script>
}

<hr class="mt-0 mb-4" />

<form method="post" asp-action="edit" asp-route-key="">
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@TITLE</h5></div>

        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.IsEnabled) Habilitado
                        </label>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    @Html.LabelFor(model => model.ExpireAt, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.ExpireAt, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.ExpireAt, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Host, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Host, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Host, null, new { @class = "text-danger" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>

            <fieldset>
                <legend class="border-bottom">Permisos</legend>
                <div>
                    @if (Model.GroupedSelectablePermissions!.Length > 0 || Model.UngroupedSelectablePermissions!.Length > 0)
                    {
                        var index = 0;

                        <ul>
                            <li>
                                <div class="row">
                                    @foreach (var item in Model.UngroupedSelectablePermissions!)
                                    {
                                        <div class="col-lg-4 col-md-6">
                                            @Html.EditorFor(model => item, "SelectionDescriptedStringIDItemInputViewModel", string.Format("SelectedPermissions[{0}]", index++))
                                        </div>
                                    }
                                </div>
                            </li>

                            @if (Model.GroupedSelectablePermissions.Length > 0)
                            {
                                foreach (var group in Model.GroupedSelectablePermissions!)
                                {
                                    <li>
                                        <fieldset>
                                            <legend class="border-bottom">@group.Key</legend>
                                            <div class="row">
                                                @foreach (var item in group.Value)
                                                {
                                                    <div class="col-lg-4 col-md-6">
                                                        @Html.EditorFor(model => item, "SelectionDescriptedStringIDItemInputViewModel", string.Format("SelectedPermissions[{0}]", index++))
                                                    </div>
                                                }
                                            </div>
                                        </fieldset>
                                    </li>
                                }
                            }
                        </ul>
                    }
                    else
                    {
                        <div>Sin elementos que mostrar.</div>
                    }
                </div>
            </fieldset>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><span class="mdi mdi-check-underline mr-1"></span>Aplicar</button>
            <a class="btn btn-outline-secondary" asp-action="index"><span class="mdi mdi-backburger mr-1"></span>Regresar al listado</a>
        </div>
    </div>
</form>