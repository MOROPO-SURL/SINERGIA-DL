@using MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Web.BackOffice.Razor.Models.View.StrategicLines

@model StrategicLineDetailViewModel

<dl class="mb-0">
    <dt>No. y Nombre</dt>
    <dd>
        @if (Model.AxeId == null)
        {
            <span>@Model.Id</span><span>. </span><span>@Model.Name</span>
        }
        else
        {
            <span>@Model.AxeId</span><span>.</span><span>@Model.Id</span><span>. </span><span>@Model.Name</span>
        }
    </dd>
    <dt>Descripción</dt>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <dd class="mb-0">@Model.Description</dd>
    }
    else
    {
        <dd class="mb-0">---</dd>
    }
</dl>