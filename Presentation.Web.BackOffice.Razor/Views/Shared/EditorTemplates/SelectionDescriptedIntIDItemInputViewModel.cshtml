@using MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Web.BackOffice.Razor.Models.View.Common.Input

@model SelectionDescriptedItemInputViewModel<int>

<div class="col-md-6">
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Label)
    @Html.HiddenFor(model => model.Description)
    
    <div class="checkbox">
        <label class="h5">
            @Html.CheckBoxFor(model => model.Selected)
            @Model.Label
        </label>
        @if (string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted"><i>Descripción no especificada</i></p>
        }
        else
        {
            <p class="text-muted">@Model.Description</p>
        }
    </div>
</div>
