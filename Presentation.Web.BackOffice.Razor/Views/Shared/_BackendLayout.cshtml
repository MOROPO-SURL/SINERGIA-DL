@{
    Layout = "_Layout";
}

@section title
{
    @if (!ViewData.ContainsKey(SessionConstants.TITLE_DICTIONARY_KEY))
    {
        <title>Admin GEDET Camagüey</title>
    }
    else
    {
        <title>Admin GEDET Camagüey - @ViewData[SessionConstants.TITLE_DICTIONARY_KEY]</title>
    }
}

@section styles
{
    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet" />

    <style type="text/css">
        legend {
            font-size: 1rem;
            line-height: 1.5;
            padding-bottom: 0.5rem;
            font-weight: 700;
        }

        th.fit, td.ft {
            width: 1px;
            word-wrap: unset;
        }

        .card .card-header[data-toggle=collapse]::after {
            font-family: 'Material Design Icons';
            content: '\F143';
            color: black;
        }

        .card .card-header[data-toggle=collapse].collapsed::after {
            content: '\F140';
        }

        .sidebar #sidebarToggle::after {
            font-family: 'Material Design Icons';
            content: '\F141';
        }

        .sidebar > ul {
            padding-inline-start: 0;
            margin-bottom: 0;
        }

        form > div.card > div.card-body > fieldset > div > ul {
            padding-inline-start: 20px;
        }

            form > div.card > div.card-body > fieldset > div > ul > li > fieldset > legend {
                font-style: italic;
                font-weight: 600;
            }

        .sidebar > ul > li, form > div.card > div.card-body > fieldset > div > ul > li {
            list-style-type: none;
            margin-left: 0;
            padding-left: 0;
        }

        .sidebar.toggled #sidebarToggle::after {
            font-family: 'Material Design Icons';
            content: '\F142';
        }

        .display-archived {
            text-decoration: line-through;
            color: lightgray;
        }
    </style>

    @RenderSection("styles", false)
}

@section scripts
{
    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    @RenderSection("scripts", false)
}

<!-- Page Wrapper -->
<div id="wrapper">

    <!-- Sidebar -->
    @await Component.InvokeAsync("DashboardSidebar")
    <!-- End of Sidebar -->
    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

        <!-- Main Content -->
        <div id="content">

            <!-- Topbar -->
            <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                <!-- Sidebar Toggle (Topbar) -->
                <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                    <i class="fa fa-bars"></i>
                </button>

                <!-- Topbar Search -->
                <div class="d-none d-sm-inline-block form-inline mr-auto my-2 my-md-0 mw-100 navbar-search">                    
                </div>

                <!-- Topbar Navbar -->
                <ul class="navbar-nav ml-auto">
                    <!-- Nav Item - User Information -->
                    <li class="nav-item dropdown no-arrow">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="mr-2 d-none d-lg-inline text-gray-600 small">@User.Identity!.Name</span>
                            <img class="img-profile rounded-circle" src="/img/default-person-picture.jpg">
                        </a>
                        <!-- Dropdown - User Information -->
                        <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                aria-labelledby="userDropdown">
                            <a class="dropdown-item" asp-action="index" asp-controller="session">
                                <i class="mdi mdi-account-circle mr-2"></i>Perfil
                            </a>
                            <a class="dropdown-item" asp-action="password" asp-controller="session">
                                <i class="mdi mdi-key-change mr-2"></i>Contraseña
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#" data-toggle="modal" data-target="#logoutModal">
                                <i class="mdi mdi-logout-variant mr-2"></i>Salir
                            </a>
                        </div>
                    </li>

                </ul>

            </nav>
            <!-- End of Topbar -->
            <!-- Begin Page Content -->
            <div class="container-fluid">
                @{
                    var notificationEntries = TempData.Where(item => item.Key.Equals(SessionConstants.NOTIFICATION_DICTIONARY_KEY)).ToArray();

                    foreach (var extraNotificationEntry in notificationEntries)
                    {
                        var notification = System.Text.Json.JsonSerializer.Deserialize<NotificationViewModel>(extraNotificationEntry!.Value!.ToString()!);

                        <div class="alert alert-dismissible fade show alert-@Html.Raw(notification!.Kind.ToString().ToLower())">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                            @if (notification.Title != null)
                            {
                                <h4>@notification.Title</h4>
                            }

                            @if (notification.MainMessage != null)
                            {
                                @Html.Raw(notification.MainMessage);
                            }

                            @if (notification.DetailMessages != null)
                            {
                                <ul>
                                    @foreach (var item in notification.DetailMessages)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                }

                @if (ViewData[SessionConstants.BREADCRUMBS_MAP_KEY] != null)
                {
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-5">
                            @{
                                ICollection<BreadcrumbViewModel> breadcrumbs = (ICollection<BreadcrumbViewModel>)ViewData[SessionConstants.BREADCRUMBS_MAP_KEY]!;

                                if (breadcrumbs != null)
                                {
                                    var total = breadcrumbs.Count();
                                    var count = 1;

                                    foreach (var breadcrumb in breadcrumbs)
                                    {
                                        if (count < total)
                                        {
                                            <li class="breadcrumb-item"><a href="@breadcrumb.Url">@Html.Raw(breadcrumb.Caption)</a></li>
                                        }
                                        else
                                        {
                                            <li class="breadcrumb-item active">@Html.Raw(breadcrumb.Caption)</li>
                                        }

                                        count++;
                                    }
                                }
                            }
                        </ol>
                    </nav>
                }

                @if (ViewData.ContainsKey(SessionConstants.HEADER_DICTIONARY_KEY))
                {
                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">@ViewData[SessionConstants.HEADER_DICTIONARY_KEY]</h1>
                    </div>
                }

                @RenderBody()
            </div>
            <!-- /.container-fluid -->

        </div>
        <!-- End of Main Content -->
        <!-- Footer -->
        <footer class="sticky-footer bg-white">
            <div class="container my-auto">
                <div class="copyright text-center my-auto">
                    <span>Copyright &copy; MOROPO S.U.R.L. @System.DateTime.Now.Year</span>
                </div>
            </div>
        </footer>
        <!-- End of Footer -->

    </div>
    <!-- End of Content Wrapper -->

</div>
<!-- End of Page Wrapper -->
<!-- Scroll to Top Button-->
<a class="scroll-to-top rounded" href="#page-top">
    <i class="mdi mdi-chevron-up"></i>
</a>

<!-- Logout Modal-->
<div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
        aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form method="post" class="modal-content" asp-action="logout" asp-controller="session">        
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Terminar la sesión?</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">De click en "Salir" si está seguro que desea terminar la sesión.</div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                <input class="btn btn-primary" type="submit" value="Salir" />
            </div>
        </form>
    </div>
</div>