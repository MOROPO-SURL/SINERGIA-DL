@{
    Layout = "_Layout";
}

@section title
{
    @if (!ViewData.ContainsKey(SessionConstants.TITLE_DICTIONARY_KEY))
    {
        <title>SINERGIA-DL Camagüey</title>
    }
    else
    {
        <title>SINERGIA-DL Camagüey - @ViewData[SessionConstants.TITLE_DICTIONARY_KEY]</title>
    }
}

@section styles {
    <style type="text/css">
        html,
        body {
            height: 100%;
        }
    </style>

    @RenderSection("styles", false)
}

@RenderBody()