<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseListEntityPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:external_common_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.External.Common.Constants;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.External.Common"
    xmlns:local_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.External.MiPyME.Models.Page.SocialResponsabilityAction"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts.Models.SocialResponsabilityAction.DTOs;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts"
    xmlns:common_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Constants;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.External.MiPyME.UI.Pages.SocialResponsabilityActionsManagementPage"
    x:TypeArguments="interop_dto_models:SRLSocialResponsabilityActionBasicDtoModel,local_page_models:SocialResponsabilityActionsManagementPageModel"
    x:DataType="local_page_models:SocialResponsabilityActionsManagementPageModel"
    Title="Gestión de Acciones de Responsabilidad Social"
    IsEnabled="{Binding IsEnabled}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Agregar"
            Command="{Binding CreateCommand, Mode=OneTime}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons"  
                    Color="{AppThemeBinding Light={StaticResource ToolbarItemLightTintColor}, Dark={StaticResource ToolbarItemDarkTintColor}}"
                    Glyph="&#xf415;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Actualizar"
            Command="{Binding ReloadCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource ToolbarItemLightTintColor}, Dark={StaticResource ToolbarItemDarkTintColor}}"
                    Glyph="&#xF450;"  />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <Grid VerticalOptions="FillAndExpand">
                <CollectionView
                    x:Name="ItemsCollectionView"
                    Style="{StaticResource ListEntityPageCollectionViewStyle}"
                    ItemsSource="{Binding Items}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout 
                            Orientation="Vertical" 
                            Span="2" 
                            HorizontalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" 
                            VerticalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Behaviors>
                        <common_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior 
                            ItemSpacing="{Static common_constants:ListEntityPageConstants.ADAPTABLE_GRIDITESMLAYOUT_COLLECTIONVIEW_BEHAVIOR_ITEMSSPACING}" 
                            ItemWidth="{Static external_common_constants:CardViewSizeConstants.SOCIALRESPONSABILITYACTION_DEFAULT_CARD_VIEW_WIDTH}" />
                    </CollectionView.Behaviors>
                    <CollectionView.EmptyView>
                        <Label
                            Style="{StaticResource CollectionPageEmptyViewLabelStyle}"
                            Margin="8"
                            IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="interop_dto_models:SRLSocialResponsabilityActionBasicDtoModel">
                            <Frame HeightRequest="{Static external_common_constants:CardViewSizeConstants.SOCIALRESPONSABILITYACTION_DEFAULT_CARD_VIEW_HEIGHT}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DetailItemCommand, Mode=OneTime}" CommandParameter="{Binding Mode=OneTime}" />
                                </Frame.GestureRecognizers>
                                <StackLayout>
                                    <Label
                                        VerticalOptions="FillAndExpand"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Title}" />
                                    <VerticalStackLayout>
                                        <Label 
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Margin="0,8,0,0"
                                            Text="Fecha" />
                                        <Label
                                            Style="{StaticResource OffLabelStyle}"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding At, StringFormat='{0:D}'}" />
                                    </VerticalStackLayout>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            <common_ui_views:BusyView IsVisible="{Binding IsBusy}" />
        </Grid>
    </ContentPage.Content>
</common_ui_base_pages:BaseListEntityPage>