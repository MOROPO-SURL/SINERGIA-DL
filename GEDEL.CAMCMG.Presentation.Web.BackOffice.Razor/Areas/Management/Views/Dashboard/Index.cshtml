@using MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Web.BackOffice.Razor.Extensions
@using MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Web.BackOffice.Razor.Models.View.Management

@model ManagementHomeViewModel

@{
    ViewData[SessionConstants.TITLE_DICTIONARY_KEY] = "Panel de Control";

    Layout = "_BackendLayout";

    string[] monthNames = new string[] { "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" };

    int dashboardSectionCount = ManagementDashboardConstants.MANAGEMENT_DASHBOARD_SECTIONS.Length;
}

@section styles {
    <link rel="stylesheet" href="~/vendor/apexcharts/apexcharts.css" />
}

<div id="management-sections" class="row">
    <div class="col-sm-6">
        @for (int i = 0; i < dashboardSectionCount; i += 2)
        {
            KeyValuePair<string, ManagementDashboardSectionViewModel[]> group = ManagementDashboardConstants.MANAGEMENT_DASHBOARD_SECTIONS[i];

            if (group.Value == null) continue;

            <div class="card shadow-lg mb-4">
                <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@group.Key</h5></div>
                <div class="card-body">
                    @{
                        var total = group.Value.Length;
                        var count = 0;
                    }
                    @while (count < total)
                    {
                        var subList = group.Value.Skip(count).Take(3);

                        <div class="row">
                            @foreach (var item in subList)
                            {
                                <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                    @if (User.IsAuthorized(item.Permission, Context))
                                    {
                                        <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                            <span class="@item.Icon mdi-36px"></span>
                                            <div class="mt-1">@item.Title</div>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            <span class="@item.Icon mdi-36px"></span>
                                            <div class="mt-1">@item.Title</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        {
                            count += 3;
                        }
                    }
                </div>
            </div>
        }
    </div>
    <div class="col-sm-6">
        @if (dashboardSectionCount > 1)
        {
            for (int i = 1; i < dashboardSectionCount; i += 2)
            {
                KeyValuePair<string, ManagementDashboardSectionViewModel[]> group = ManagementDashboardConstants.MANAGEMENT_DASHBOARD_SECTIONS[i];

                if (group.Value == null) continue;

                <div class="card shadow-lg mb-4">
                    <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@group.Key</h5></div>
                    <div class="card-body">
                        @{
                            var total = group.Value.Length;
                            var count = 0;
                        }
                        @while (count < total)
                        {
                            var subList = group.Value.Skip(count).Take(3);

                            <div class="row">
                                @foreach (var item in subList)
                                {
                                    <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                        @if (User.IsAuthorized(item.Permission, Context))
                                        {
                                            <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                                <span class="@item.Icon mdi-36px"></span>
                                                <div class="mt-1">@item.Title</div>
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="text-muted">
                                                <span class="@item.Icon mdi-36px"></span>
                                                <div class="mt-1">@item.Title</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            {
                                count += 3;
                            }
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>