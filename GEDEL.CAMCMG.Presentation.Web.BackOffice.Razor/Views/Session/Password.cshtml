@using MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Presentation.Web.BackOffice.Razor.Models.View.Session

@model SessionChangePasswordUpdateViewModel

@{
    const string TITLE = "Cambiar contraseña";

    ViewData[SessionConstants.TITLE_DICTIONARY_KEY] = TITLE;

    ViewData["Title"] = TITLE;

    ViewData[SessionConstants.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel(
            "<span class=\"mdi mdi-account-circle\" style=\"margin-right: 4px;\"></span> Perfil de Usuario",
            Url.Action("index", "session")),
        new BreadcrumbViewModel(TITLE)
    };

    Layout = "_AuthenticatedFrontendLayout";
}

<h3>@TITLE</h3>

<hr />

<form method="post">
    @Html.ValidationSummary(true)

    <div class="row">
        <div class="form-group col-md-6 mb-3">
            @Html.LabelFor(m => m.CurrentPassword, new { @class = "control-label" })
            @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.CurrentPassword, null, new { @class = "text-danger" })
        </div>
    </div>
    <div class="row">
        <div class="form-group col-md-6 mb-3">
            @Html.LabelFor(m => m.NewPassword, new { @class = "control-label" })
            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.NewPassword)
        </div>

        <div class="form-group col-md-6 mb-3">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label" })
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, null, new { @class = "text-danger" })
        </div>
    </div>

    <hr />

    <div>
        <button type="submit" class="btn btn-primary"><span class="mdi mdi-check-underline mr-1"></span>Aplicar</button>
        <a class="btn btn-outline-secondary" asp-action="index"><span class="mdi mdi-window-close mr-1"></span>Cancelar</a>
    </div>
</form>
