<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseConfigurationEntityPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.External.PDL.Models.Page.OperationReport"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.OperationReport.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    xmlns:common_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Constants;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.External.PDL.UI.Pages.OperationReport.OperationReportConfigurationPage"
    x:TypeArguments="interop_dto_models:PDLOperationReportDetailDtoModel,interop_dto_models:PDLOperationReportDetailDtoModel,local_page_models:OperationReportConfigurationPageModel"
    x:DataType="local_page_models:OperationReportConfigurationPageModel"
    Shell.TabBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Command="{Binding ApplyCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource ToolbarItemLightTintColor}, Dark={StaticResource ToolbarItemDarkTintColor}}"
                    Glyph="&#xf12c;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Command="{Binding CancelCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons"
                    Color="{AppThemeBinding Light={StaticResource ToolbarItemLightTintColor}, Dark={StaticResource ToolbarItemDarkTintColor}}"
                    Glyph="&#xf156;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <Frame 
                    Style="{StaticResource WarningToastFrameStyle}"
                    Margin="8">
                    <StackLayout 
                        Orientation="Horizontal"
                        Spacing="8">
                        <Label
                            VerticalOptions="Center"
                            FontSize="32"
                            FontFamily="MaterialDesignIcons"
                            Text="&#xF01FA;" />
                        <Label 
                            HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                            Text="Los datos económicos deberan ser los valores del período especificado y no acumulados, como está indicado para los informes físicos al CAM." />
                    </StackLayout>
                </Frame>
                <Frame 
                    Style="{StaticResource InfoToastFrameStyle}"
                    Margin="8">
                    <StackLayout 
                        Orientation="Horizontal"
                        Spacing="8">
                        <Label
                            VerticalOptions="Center"
                            FontSize="32"
                            FontFamily="MaterialDesignIcons"
                            TextColor="White"
                            Text="&#xF2FD;" />
                        <Label 
                            HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                            TextColor="White">
                            <Label.Behaviors>
                                <common_ui_behaviors:DecimalSymbolIdicatotionLabelBehavior />
                            </Label.Behaviors>
                        </Label>
                    </StackLayout>
                </Frame>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Periodo" />
                        <DatePicker Date="{Binding Period}" Format="MM-yyyy" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descripción (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="120" />
                    <Label>
                        <Label.Behaviors>
                            <common_ui_behaviors:ValidationMessageLabelBehavior 
                                TargetValidationPropertyName="{Static local_page_models:OperationReportConfigurationPageModel.DescriptionValidableProperty}"
                                InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                        </Label.Behaviors>
                    </Label>
                </VerticalStackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Ingresos" />
                        <Entry 
                            HorizontalTextAlignment="End"
                            Text="{Binding Income}" />
                        <Label>
                            <Label.Behaviors>
                                <common_ui_behaviors:ValidationMessageLabelBehavior 
                                TargetValidationPropertyName="{Static local_page_models:OperationReportConfigurationPageModel.IncomeValidableProperty}"
                                InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                            </Label.Behaviors>
                        </Label>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Deposito de efectivo" />
                        <Entry 
                            HorizontalTextAlignment="End"
                            Text="{Binding IncomeBankDeposit}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Utilidades / Pérdidas" />
                        <Entry 
                            HorizontalTextAlignment="End"
                            Text="{Binding PeriodResult}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Aportes al CAM" />
                        <Entry 
                            HorizontalTextAlignment="End"
                            Text="{Binding CAMComission}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,16,8,0">
                    <Label 
                        Style="{StaticResource CaptionFieldLabelStyle}" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        Text="Recursos humanos" />
                    <BoxView
                        Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                        Margin="0"
                        HeightRequest="2"
                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                </StackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Personas contratadas" />
                        <Grid>
                            <Entry 
                                IsReadOnly="True"
                                Text="{Binding EmployeeCount}" />
                            <Stepper 
                                Margin="0,0,6,0"
                                HorizontalOptions="End" VerticalOptions="Center"
                                Minimum="0" Maximum="5000"
                                Value="{Binding EmployeeCount}" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="De sexo femenino" />
                        <Grid>
                            <Entry 
                                IsReadOnly="True"
                                Text="{Binding FemaleEmployeeCount}" />
                            <Stepper  
                                Margin="0,0,6,0"
                                HorizontalOptions="End" VerticalOptions="Center"
                                Minimum="0" Maximum="5000"
                                Value="{Binding FemaleEmployeeCount}" />
                        </Grid>
                        <Label>
                            <Label.Behaviors>
                                <common_ui_behaviors:ValidationMessageLabelBehavior 
                                    TargetValidationPropertyName="{Static local_page_models:OperationReportConfigurationPageModel.FemaleEmployeeCountValidableProperty}"
                                    InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                            </Label.Behaviors>
                        </Label>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Con necesidades especiales" />
                        <Grid>
                            <Entry 
                                IsReadOnly="True"
                                Text="{Binding DiscapacityEmployeeCount}" />
                            <Stepper  
                                Margin="0,0,6,0"
                                HorizontalOptions="End" VerticalOptions="Center"
                                Minimum="0" Maximum="5000"
                                Value="{Binding DiscapacityEmployeeCount}" />
                        </Grid>
                        <Label>
                            <Label.Behaviors>
                                <common_ui_behaviors:ValidationMessageLabelBehavior 
                                    TargetValidationPropertyName="{Static local_page_models:OperationReportConfigurationPageModel.DiscapacityEmployeeCountValidableProperty}"
                                    InvalidStateStyle="{StaticResource ValidationMessageLabelStyle}" />
                            </Label.Behaviors>
                        </Label>
                    </VerticalStackLayout>
                </FlexLayout>
                <StackLayout 
                    Style="{StaticResource FormFluentChildStackLayoutStyle}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,16,8,0">
                    <Label 
                        Style="{StaticResource CaptionFieldLabelStyle}" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        Text="Gestión energética" />
                    <BoxView
                        Style="{StaticResource FormFluentChildSeparatorBoxViewStyle}"
                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                        Margin="0"
                        HeightRequest="2"
                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                </StackLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Consumo desde la red nacional" />
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Entry 
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="End"
                                Text="{Binding GridEnergySpend}" />
                            <Label
                                VerticalOptions="Center"
                                Text="Kw" />
                        </StackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Generación renovable" />
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Entry 
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="End"
                                Text="{Binding RenerenewableEnergyGeneration}" />
                            <Label
                                VerticalOptions="Center"
                                Text="Kw" />
                        </StackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Entrega renovable a la red" />
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Entry 
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="End"
                                Text="{Binding RenerenewableEnergyExportation}" />
                            <Label
                                VerticalOptions="Center"
                                Text="Kw" />
                        </StackLayout>
                    </VerticalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</common_ui_base_pages:BaseConfigurationEntityPage>