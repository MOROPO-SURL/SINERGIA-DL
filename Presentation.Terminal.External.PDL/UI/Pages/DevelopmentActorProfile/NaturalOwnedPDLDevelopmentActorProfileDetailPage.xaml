<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseBindingContextedContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.External.PDL.Models.Page.DevelopmentActorProfile"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts.Models.Location.DTOs;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts"
    xmlns:common_constants="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Constants;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_card_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views.Card;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_behaviors="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Behaviors;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_converters="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Converters;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:ffimageloading_views="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.External.PDL.UI.Pages.NaturalOwnedPDLDevelopmentActorProfileDetailPage"
    x:TypeArguments="local_page_models:NaturalOwnedPDLDevelopmentActorProfileDetailPageModel"
    x:DataType="local_page_models:NaturalOwnedPDLDevelopmentActorProfileDetailPageModel"
    Title="Perfil de actor del desarrollo">
    <ContentPage.Resources>
        <ResourceDictionary>
            <common_ui_converters:ImageBasicModelToImageSourceConverter x:Key="ImageBasicModelToImageSourceConverter" />
            <common_ui_converters:PostalAddressDetailDtoModelToStringConverter x:Key="PostalAddressDetailDtoModelToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Modificar"
            Command="{Binding ModifyCommand, Mode=OneTime}">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons"  
                    Color="{AppThemeBinding Light={StaticResource ToolbarItemLightTintColor}, Dark={StaticResource ToolbarItemDarkTintColor}}"
                    Glyph="&#xF90B;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Fecha de fundación" />
                        <Label Text="{Binding Model.BornAt}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=12}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="NIT" />
                        <Label Text="{Binding Model.FiscalIdentificationCode}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=3, LargeContainerColumn=4, SmallContainerColumn=12}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Modalidad" />
                        <Label 
                            LineBreakMode="TailTruncation"
                            Text="{Binding Model.Modality.Name}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <FlexLayout Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FormFlexWrappedChildVerticalStackLayoutStyle}">
                        <VerticalStackLayout.Behaviors>
                            <common_ui_behaviors:FlexLayoutResponsiveChildViewBehavior 
                                ResponsiveColumnConfiguration="{common_ui_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=3, ExtraLargeContainerColumn=4, LargeContainerColumn=6, MediumContainerColumn=8, SmallContainerColumn=10}" />
                        </VerticalStackLayout.Behaviors>
                        <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Titular" />
                        <Frame>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border 
                                    Grid.Column="0"
                                    StrokeThickness="4"
                                    StrokeLineJoin="Bevel">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="36" />
                                    </Border.StrokeShape>
                                    <ffimageloading_views:CachedImage
                                        WidthRequest="72" HeightRequest="72"
                                        Source="{Binding Model.Holder.Image, Converter={StaticResource ImageBasicModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                                </Border>
                                <VerticalStackLayout 
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        ToolTipProperties.Text="{Binding Model.Holder.Name}"
                                        Text="{Binding Model.Holder.Name}" />
                                    <Label
                                        MaxLines="1"
                                        LineBreakMode="TailTruncation"
                                        ToolTipProperties.Text="{Binding Model.Holder.LastName}"
                                        Text="{Binding Model.Holder.LastName}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Actividad económica principal" />
                    <Grid ColumnSpacing="4" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            VerticalOptions="Start"
                            Text="{Binding Model.MainEconomicActivity.Id, StringFormat='{0}.'}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding Model.MainEconomicActivity.Name}" />
                    </Grid>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Actividades secundarias" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <CollectionView ItemsSource="{Binding Model.SecoundaryEconomicActivities}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout 
                                Orientation="Vertical" 
                                Span="2" 
                                HorizontalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" 
                                VerticalItemSpacing="{Static common_constants:ListEntityPageConstants.COLLECTIONVIEW_ITEMSLAYOUT_ITEMSPACING}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <common_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior 
                                ItemSpacing="{Static common_constants:ListEntityPageConstants.ADAPTABLE_GRIDITESMLAYOUT_COLLECTIONVIEW_BEHAVIOR_ITEMSSPACING}" 
                                ItemWidth="{Static common_constants:CardViewSizeConstants.ECONOMICACTIVITY_DEFAULT_CARD_VIEW_WIDTH}" />
                        </CollectionView.Behaviors>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <common_ui_card_views:EconomicActivityCardView HeightRequest="{Static common_constants:CardViewSizeConstants.ECONOMICACTIVITY_DEFAULT_CARD_VIEW_HEIGHT}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Localización de domicilio social" />
                    <Frame Padding="8">
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <VerticalStackLayout 
                                HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                Margin="8,0,0,0">
                                <Label 
                                    LineBreakMode="TailTruncation"
                                    FontAttributes="Bold"
                                    Text="{Binding Model.MainLocation.Name}" />
                                <Label
                                    Style="{StaticResource OffLabelStyle}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Model.MainLocation.PostalAddress, Converter={StaticResource PostalAddressDetailDtoModelToStringConverter}}" />
                            </VerticalStackLayout>
                            <Button
                                Style="{StaticResource FontIconImageButtonStyle}"
                                VerticalOptions="Center"
                                Text="&#xF2FD;"
                                Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DetailLocationCommand}"
                                CommandParameter="{Binding Model.MainLocation}" />
                        </StackLayout>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Localizaciones comerciales" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <CollectionView
                        Grid.ColumnSpan="2" Grid.Row="2"
                        ItemsSource="{Binding Model.CommercialLocations}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="interop_dto_models:LocationDetailDtoModel">
                                <Frame Padding="8">
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <VerticalStackLayout 
                                            HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                            Margin="8,0,0,0">
                                            <Label 
                                                LineBreakMode="TailTruncation"
                                                FontAttributes="Bold"
                                                Text="{Binding Name, Mode=OneTime}" />
                                            <Label
                                                Style="{StaticResource OffLabelStyle}"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding PostalAddress, Converter={StaticResource PostalAddressDetailDtoModelToStringConverter}, Mode=OneTime}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Style="{StaticResource FontIconImageButtonStyle}"
                                            VerticalOptions="Center"
                                            Text="&#xF2FD;"
                                            Command="{Binding Source={RelativeSource AncestorType={Type Page}}, Path=BindingContext.DetailLocationCommand, Mode=OneTime}"
                                            CommandParameter="{Binding Mode=OneTime}" />
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Acerca de" />
                    <Label Text="{Binding Model.About, TargetNullValue='---'}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</common_ui_base_pages:BaseBindingContextedContentPage>