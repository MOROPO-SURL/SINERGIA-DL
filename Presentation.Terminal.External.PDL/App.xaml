    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common_style_resources:SharedStylesDictionary />

                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <x:String x:Key="FontMaterialDesignIcons">MaterialDesignIcons</x:String>

            <x:String x:Key="IconGlyphContext">&#xF002B;</x:String>
            <x:String x:Key="IconGlyphEDL">&#xFA1C;</x:String>
            <x:String x:Key="IconGlyphHelp">&#xF87D;</x:String>
            <x:String x:Key="IconGlyphConfig">&#xF66A;</x:String>
            <x:String x:Key="IconGlyphUserProfile">&#xF009;</x:String>
            <x:String x:Key="IconGlyphLogOut">&#xFA47;</x:String>
        </ResourceDictionary>
    </Application.Resources>
</Application>
