<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.EconomicActivity.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views.Card.EconomicActivityCardView"
    x:DataType="interop_dto_models:EconomicActivityBasicDtoModel">
    <Frame InputTransparent="{OnPlatform Default=False, Android=True}">
        <Grid ColumnSpacing="4" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                VerticalOptions="Start"
                Text="{Binding Id, StringFormat='{0}.'}" />
            <Label
                Grid.Column="1"
                MaxLines="3"
                LineBreakMode="TailTruncation"
                Text="{Binding Name}" />
        </Grid>
    </Frame>
</ContentView>
