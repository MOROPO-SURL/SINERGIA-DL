<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_ui_converters="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Converters"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts.Models.Organization.DTOs;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Interop.Contracts"
    xmlns:ffimageloading_views="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views.Card.OrganizationCardView"
    x:DataType="interop_dto_models:OrganizationBasicDtoModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <local_ui_converters:ImageBasicModelToImageSourceConverter x:Key="ImageBasicModelToImageSourceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame 
        Padding="0"
        InputTransparent="{OnPlatform Default=False, Android=True}">
        <Grid ColumnSpacing="0" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ffimageloading_views:CachedImage
                Grid.Column="0"
                Aspect="AspectFill"
                Source="{Binding Image, Converter={StaticResource ImageBasicModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
            <BoxView
                Grid.Column="1"
                Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
            <StackLayout 
                Grid.Column="2"
                Padding="8"
                Orientation="Vertical">
                <Label
                    VerticalOptions="FillAndExpand"
                    FontAttributes="Bold"
                    LineBreakMode="TailTruncation"
                    MaxLines="3"
                    ToolTipProperties.Text="{Binding Name}"
                    Text="{Binding Name}" />
                <Label 
                    Style="{StaticResource CaptionPropertyLabelStyle}"
                    Margin="0,8,0,0"
                    Text="Tipo" />
                <Label
                    Style="{StaticResource OffLabelStyle}"
                    LineBreakMode="TailTruncation"
                    ToolTipProperties.Text="{Binding Kind.Name}"
                    Text="{Binding Kind.Name}" />
            </StackLayout>
        </Grid>
    </Frame>
</ContentView>
