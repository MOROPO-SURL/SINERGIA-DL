<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseBindingContextedContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_view_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models.View"
    xmlns:local_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models.Page"
    xmlns:interop_project_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.StrategicProject.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:common_ui_views="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Views;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.StrategySummaryPage"
    x:TypeArguments="local_page_models:StrategySummaryPageModel"
    x:DataType="local_page_models:StrategySummaryPageModel"
    Title="Estrategia">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <communitytoolkit_converters:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons" 
                    Color="{AppThemeBinding Light={StaticResource ToolbarItemLightTintColor}, Dark={StaticResource ToolbarItemDarkTintColor}}"
                    Glyph="&#xF450;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Exportar"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            Clicked="DownloadToolbarItems_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="MaterialDesignIcons"  
                    Color="{AppThemeBinding Light={StaticResource ToolbarItemLightTintColor}, Dark={StaticResource ToolbarItemDarkTintColor}}"
                    Glyph="&#xF1DA;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Style="{StaticResource FormScrollRootVerticalStackLayoutStyle}">
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label
                        FontSize="Medium"
                        FontAttributes="Bold"
                        Text="Resumen" />
                </VerticalStackLayout>
                <VerticalStackLayout Style="{StaticResource FormFluentChildVerticalStackLayoutStyle}">
                    <Label
                        FontAttributes="Bold"
                        Text="Ejes estratégicos" />
                    <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                    <CollectionView ItemsSource="{Binding Axes}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local_view_models:DeepStrategicAxeViewModel">
                                <VerticalStackLayout Spacing="8">
                                    <StackLayout Orientation="Horizontal" Spacing="4">
                                        <Label 
                                            FontSize="Medium"
                                            Text="{Binding Axe.Id, StringFormat='{0}.'}" />
                                        <Label
                                            HorizontalOptions="FillAndExpand"
                                            FontSize="Medium"
                                            Text="{Binding Axe.Name}" />
                                    </StackLayout>
                                    <Label 
                                        Style="{StaticResource OffLabelStyle}"
                                        IsVisible="{Binding Axe.Description, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                        Text="{Binding Axe.Description}" />
                                    <VerticalStackLayout Margin="16,0,0,0">
                                        <Label
                                            FontAttributes="Bold"
                                            Text="Líneas estratégicas" />
                                        <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                                        <CollectionView ItemsSource="{Binding Lines}">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.EmptyView>
                                                <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                                            </CollectionView.EmptyView>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="local_view_models:DeepStrategicLineViewModel">
                                                    <VerticalStackLayout Spacing="8">
                                                        <StackLayout Orientation="Horizontal" Spacing="4">
                                                            <Label 
                                                                FontSize="Medium">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding Line.Axe.Id, StringFormat='{0}.'}" />
                                                                        <Span Text="{Binding Line.Index, StringFormat='{0}.'}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                            <Label
                                                                HorizontalOptions="FillAndExpand"
                                                                FontSize="Medium"
                                                                Text="{Binding Line.Name}" />
                                                        </StackLayout>
                                                        <VerticalStackLayout>
                                                            <Label 
                                                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                                                Text="Coordinador" />
                                                            <Label>
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding Line.Coordinator.Name}" />
                                                                        <Span Text="{Binding Line.Coordinator.LastName, StringFormat=' {0}'}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </VerticalStackLayout>
                                                        <Label 
                                                            Style="{StaticResource OffLabelStyle}"
                                                            IsVisible="{Binding Line.Description, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                                            Text="{Binding Line.Description}" />
                                                        <VerticalStackLayout Margin="24,0,0,0">
                                                            <Label
                                                                FontAttributes="Bold"
                                                                Text="Programas" />
                                                            <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                                                            <CollectionView ItemsSource="{Binding Programs}">
                                                                <CollectionView.ItemsLayout>
                                                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                                                </CollectionView.ItemsLayout>
                                                                <CollectionView.EmptyView>
                                                                    <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                                                                </CollectionView.EmptyView>
                                                                <CollectionView.ItemTemplate>
                                                                    <DataTemplate x:DataType="local_view_models:DeepStrategicProgramViewModel">
                                                                        <VerticalStackLayout Spacing="8">
                                                                            <Label
                                                                                HorizontalOptions="FillAndExpand"
                                                                                FontSize="Medium"
                                                                                Text="{Binding Program.Name}" />
                                                                            <Label 
                                                                                Style="{StaticResource OffLabelStyle}"
                                                                                IsVisible="{Binding Program.Description, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                                                                Text="{Binding Program.Description}" />
                                                                            <VerticalStackLayout>
                                                                                <Label 
                                                                                    Style="{StaticResource CaptionPropertyLabelStyle}"
                                                                                    Text="Coordinador" />
                                                                                <Label>
                                                                                    <Label.FormattedText>
                                                                                        <FormattedString>
                                                                                            <Span Text="{Binding Program.Coordinator.Name}" />
                                                                                            <Span Text="{Binding Program.Coordinator.LastName, StringFormat=' {0}'}" />
                                                                                        </FormattedString>
                                                                                    </Label.FormattedText>
                                                                                </Label>
                                                                            </VerticalStackLayout>
                                                                            <VerticalStackLayout Margin="24,0,0,0">
                                                                                <Label
                                                                                    FontAttributes="Bold"
                                                                                    Text="Proyectos" />
                                                                                <BoxView Style="{StaticResource DetailSectionSeparatorBoxViewStyle}" />
                                                                                <CollectionView ItemsSource="{Binding Projects}">
                                                                                    <CollectionView.ItemsLayout>
                                                                                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                                                                    </CollectionView.ItemsLayout>
                                                                                    <CollectionView.EmptyView>
                                                                                        <Label Style="{StaticResource CollectionFrameEmptyViewLabelStyle}" />
                                                                                    </CollectionView.EmptyView>
                                                                                    <CollectionView.ItemTemplate>
                                                                                        <DataTemplate x:DataType="interop_project_dto_models:StrategicProjectDetailDtoModel">
                                                                                            <Grid ColumnSpacing="8" RowSpacing="8">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                    <ColumnDefinition />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Grid.RowDefinitions>
                                                                                                    <RowDefinition Height="Auto" />
                                                                                                    <RowDefinition Height="Auto" />
                                                                                                    <RowDefinition Height="Auto" />
                                                                                                </Grid.RowDefinitions>
                                                                                                <Label
                                                                                                    Grid.Column="0" Grid.RowSpan="2"
                                                                                                    Margin="0,8,0,0"
                                                                                                    VerticalOptions="Start"
                                                                                                    FontFamily="{StaticResource FontMaterialDesignIcons}"
                                                                                                    Text="&#xFA12;" />
                                                                                                <Label 
                                                                                                    Grid.Column="1" Grid.Row="0"
                                                                                                    FontSize="Medium"
                                                                                                    Text="{Binding Name}" />
                                                                                                <VerticalStackLayout Grid.Column="1" Grid.Row="1">
                                                                                                    <Label 
                                                                                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                                                                                        Text="Tipo" />
                                                                                                    <Label Text="{Binding Kind.Name}" />
                                                                                                </VerticalStackLayout>
                                                                                                <Label
                                                                                                    IsVisible="{Binding Description, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                                                                                    Grid.Column="1" Grid.Row="2"
                                                                                                    Style="{StaticResource OffLabelStyle}"
                                                                                                    Text="{Binding Description}" />
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </CollectionView.ItemTemplate>
                                                                                </CollectionView>
                                                                            </VerticalStackLayout>
                                                                        </VerticalStackLayout>
                                                                    </DataTemplate>
                                                                </CollectionView.ItemTemplate>
                                                            </CollectionView>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <common_ui_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</common_ui_base_pages:BaseBindingContextedContentPage>