<?xml version="1.0" encoding="utf-8" ?>
<common_ui_base_pages:BaseDetailEntityPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_detail_page_models="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.Models.Page.Common.Detail"
    xmlns:interop_dto_models="clr-namespace:MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts.Models.Common.DTOs;assembly=MOROPO.PDLCoLabCMG.GEDEL.CAMCMG.Interop.Contracts"
    xmlns:common_ui_base_pages="clr-namespace:MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Bases;assembly=MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common"
    x:Class="MOROPO.PDLCoLabCMG.SINERGIADL.CMG.Presentation.Terminal.Common.UI.Pages.Common.Detail.EmailAddressDetailPage"
    x:TypeArguments="interop_dto_models:EmailAddressDetailDtoModel,local_detail_page_models:EmailAddressDetailPageModel"
    x:DataType="local_detail_page_models:EmailAddressDetailPageModel"
    Title="Detalles de Dirección de correo electrónico"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="400"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <VerticalStackLayout Margin="20">
                        <Label 
                            Margin="0,0,0,20"
                            Text="Detalles"
                            FontAttributes="Bold"
                            FontSize="Medium" />
                        <Label
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Text="Dirección" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding Model.Value}" />
                        <Label 
                            Style="{StaticResource CaptionPropertySpacedLabelStyle}"
                            Text="Nombre" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding Model.Name, TargetNullValue='---'}" />
                    </VerticalStackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</common_ui_base_pages:BaseDetailEntityPage>